@model ChangePasswordViewModel
@{
    Layout = "~/Areas/Member/Views/Shared/_MemberLayout.cshtml";
    ViewData["Title"] = "Şifre Değiştir";
}

<div class="m-page-head">
    <h1>Şifre Değiştir</h1>
    <p>Hesap güvenliğiniz için güçlü bir şifre seçmenizi öneririz.</p>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="flash flash-success">@TempData["SuccessMessage"]</div>
}

<div style="display:grid; grid-template-columns:2fr 1fr; gap:20px; align-items:start;">

    <div class="m-card">
        <div class="m-card__body">

            <form asp-action="ChangePassword" method="post">
                <div asp-validation-summary="ModelOnly" style="color:var(--danger); font-size:13px; margin-bottom:14px;"></div>

                <div class="form-group">
                    <label asp-for="CurrentPassword" class="form-label"></label>
                    <input asp-for="CurrentPassword" class="form-input" placeholder="Şuan ki Şifreniz" autocomplete="current-password" />
                    <span asp-validation-for="CurrentPassword" class="field-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="NewPassword" class="form-label"></label>
                    <input asp-for="NewPassword" class="form-input" placeholder="Yeni Şifreniz" autocomplete="new-password" />
                    <span asp-validation-for="NewPassword" class="field-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="ConfirmPassword" class="form-label"></label>
                    <input asp-for="ConfirmPassword" class="form-input" placeholder="Yeni Şifreniz" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword" class="field-error"></span>
                </div>

                <button type="submit" class="m-btn m-btn-primary" style="width:100%; justify-content:center; margin-top:8px;">
                    Şifreyi Güncelle
                </button>
            </form>

        </div>
    </div>

    <div style="display:flex; flex-direction:column; gap:16px;">

        <div class="m-card">
            <div class="m-card__body">
                <h3 class="section-title">Güçlü Şifre İpuçları</h3>

                <div class="tip-row">
                    <div class="tip-row__icon">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="20 6 9 17 4 12"></polyline>
                        </svg>
                    </div>
                    <span>En az 8 karakter kullanın.</span>
                </div>

                <div class="tip-row">
                    <div class="tip-row__icon">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="20 6 9 17 4 12"></polyline>
                        </svg>
                    </div>
                    <span>Büyük/küçük harf ve rakam birlikte kullanın.</span>
                </div>

                <div class="tip-row">
                    <div class="tip-row__icon">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="20 6 9 17 4 12"></polyline>
                        </svg>
                    </div>
                    <span>Ad, soyad veya doğum tarihi gibi tahmin edilebilir bilgiler kullanmayın.</span>
                </div>

                <div class="tip-row" style="border-bottom:none;">
                    <div class="tip-row__icon">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="20 6 9 17 4 12"></polyline>
                        </svg>
                    </div>
                    <span>Şifrenizi başka hiçbir hesapta kullanmayın.</span>
                </div>
            </div>
        </div>

        <div class="m-card" style="background:var(--ink-900); border-color:var(--ink-900);">
            <div class="m-card__body">
                <h3 style="font-family:var(--font-display); font-size:15.5px; font-weight:600; margin:0 0 8px; color:#fff;">
                    Şifre değişince ne olur?
                </h3>
                <p style="font-size:12.5px; color:#9aa6ba; margin:0; line-height:1.6;">
                    Şifreniz güncellendiğinde oturumunuz bu cihazda açık kalır, ancak diğer cihazlardaki oturumlarınız güvenlik amacıyla sonlandırılabilir.
                </p>
            </div>
        </div>

    </div>
</div>

<style>
    .section-title {
        font-family: var(--font-display);
        font-size: 15.5px;
        font-weight: 600;
        margin: 0 0 14px;
        color: var(--text-900);
    }

    .form-group {
        margin-bottom: 18px;
    }

    .form-label {
        display: block;
        font-size: 12.5px;
        font-weight: 600;
        color: var(--text-900);
        margin-bottom: 6px;
    }

    .form-input {
        width: 100%;
        height: 42px;
        border-radius: 10px;
        border: 1px solid var(--line);
        padding: 0 14px;
        font-size: 14px;
        color: var(--text-900);
        background: var(--paper);
    }

        .form-input:focus {
            outline: none;
            border-color: var(--accent);
            background: var(--white);
        }

    .field-error {
        display: block;
        font-size: 11.5px;
        color: var(--danger);
        margin-top: 4px;
    }

    .tip-row {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        padding: 10px 0;
        border-bottom: 1px solid var(--line-soft);
        font-size: 12.5px;
        color: var(--text-600);
        line-height: 1.5;
    }

        .tip-row:first-child {
            padding-top: 0;
        }

    .tip-row__icon {
        width: 22px;
        height: 22px;
        border-radius: 50%;
        background: var(--success-100);
        color: var(--success);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        margin-top: 1px;
    }

    @@media (max-width: 900px) {
        div[style*="grid-template-columns:2fr 1fr"] {
            grid-template-columns: 1fr !important;
        }
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}