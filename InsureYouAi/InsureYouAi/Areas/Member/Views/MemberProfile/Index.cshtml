@model MemberProfileViewModel
@{
    Layout = "~/Areas/Member/Views/Shared/_MemberLayout.cshtml";
    ViewData["Title"] = "Profilim";
    string initial = string.IsNullOrWhiteSpace(Model.FullName) ? "?" : Model.FullName.Trim()[0].ToString().ToUpper();
}

<div class="m-page-head">
    <h1>Profilim</h1>
    <p>Hesap bilgilerinizi buradan görüntüleyebilirsiniz.</p>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="flash flash-success">@TempData["SuccessMessage"]</div>
}

<div style="display:grid; grid-template-columns:2fr 1fr; gap:20px; align-items:start;">

    <div style="display:flex; flex-direction:column; gap:20px;">

        <div class="m-card">
            <div class="m-card__body" style="display:flex; align-items:center; gap:20px; padding:28px 28px;">

                @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl" alt="@Model.FullName" class="profile-avatar" />
                }
                else
                {
                    <div class="profile-avatar profile-avatar--fallback">@initial</div>
                }

                <div style="flex:1; min-width:0;">
                    <h2 class="profile-name">@Model.FullName</h2>
                    <p class="profile-email">@Model.Email</p>
                </div>

                <a asp-area="Member" asp-controller="MemberProfile" asp-action="Edit" class="m-btn m-btn-primary" style="flex-shrink:0;">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                        <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                    </svg>
                    Düzenle
                </a>
            </div>
        </div>

        <div class="m-card">
            <div class="m-card__body">
                <h3 class="section-title">Hesap Bilgileri</h3>

                <div class="info-row">
                    <div class="info-row__icon">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                            <circle cx="12" cy="7" r="4"></circle>
                        </svg>
                    </div>
                    <div>
                        <div class="info-row__label">Ad Soyad</div>
                        <div class="info-row__value">@Model.FullName</div>
                    </div>
                </div>

                <div class="info-row">
                    <div class="info-row__icon">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M22 6l-10 7L2 6"></path>
                            <rect x="2" y="4" width="20" height="16" rx="2"></rect>
                        </svg>
                    </div>
                    <div>
                        <div class="info-row__label">E-posta</div>
                        <div class="info-row__value">@Model.Email</div>
                    </div>
                </div>

                <div class="info-row">
                    <div class="info-row__icon">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"></path>
                        </svg>
                    </div>
                    <div>
                        <div class="info-row__label">Telefon</div>
                        <div class="info-row__value">@(string.IsNullOrWhiteSpace(Model.PhoneNumber) ? "—" : Model.PhoneNumber)</div>
                    </div>
                </div>

                <div class="info-row" style="border-bottom:none;">
                    <div class="info-row__icon">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                        </svg>
                    </div>
                    <div>
                        <div class="info-row__label">Hakkında</div>
                        <div class="info-row__value">@(string.IsNullOrWhiteSpace(Model.Description) ? "Henüz bir açıklama eklenmemiş." : Model.Description)</div>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <div style="display:flex; flex-direction:column; gap:16px;">

        <div class="m-card">
            <div class="m-card__body">
                <h3 class="section-title" style="margin-bottom:14px;">Hesap Güvenliği</h3>

                <a href="/Member/MemberProfile/ChangePassword" class="side-link">
                    <span class="side-link__icon">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="11" width="18" height="11" rx="2"></rect>
                            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                        </svg>
                    </span>
                    <span>Şifre Değiştir</span>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-left:auto; opacity:0.4;">
                        <polyline points="9 18 15 12 9 6"></polyline>
                    </svg>
                </a>

                <a href="/Account/LogOut" class="side-link" style="color:var(--danger);">
                    <span class="side-link__icon" style="background:var(--danger-100); color:var(--danger);">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                            <polyline points="16 17 21 12 16 7"></polyline>
                            <line x1="21" y1="12" x2="9" y2="12"></line>
                        </svg>
                    </span>
                    <span>Çıkış Yap</span>
                </a>
            </div>
        </div>

        <div class="m-card">
            <div class="m-card__body">
                <h3 class="section-title" style="margin-bottom:14px;">Hızlı Erişim</h3>

                <a asp-area="Member" asp-controller="MemberPolicies" asp-action="MemberPolicyList" class="side-link">
                    <span class="side-link__icon">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                        </svg>
                    </span>
                    <span>Poliçelerim</span>
                </a>

                <a asp-area="Member" asp-controller="MemberArticle" asp-action="MemberArticleList" class="side-link">
                    <span class="side-link__icon">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path>
                            <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
                        </svg>
                    </span>
                    <span>Makalelerim</span>
                </a>
            </div>
        </div>

        <div class="m-card" style="background:var(--ink-900); border-color:var(--ink-900);">
            <div class="m-card__body">
                <h3 style="font-family:var(--font-display); font-size:15.5px; font-weight:600; margin:0 0 8px; color:#fff;">
                    Bilgileriniz güvende
                </h3>
                <p style="font-size:12.5px; color:#9aa6ba; margin:0; line-height:1.6;">
                    Kişisel verileriniz KVKK kapsamında korunmakta ve üçüncü taraflarla paylaşılmamaktadır.
                </p>
            </div>
        </div>

    </div>
</div>

<style>
    .section-title {
        font-family: var(--font-display);
        font-size: 15.5px;
        font-weight: 600;
        margin: 0 0 18px;
        color: var(--text-900);
    }

    .profile-avatar {
        width: 68px;
        height: 68px;
        border-radius: 50%;
        object-fit: cover;
        flex-shrink: 0;
    }

    .profile-avatar--fallback {
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--ink-900);
        color: #e4c98a;
        font-family: var(--font-display);
        font-size: 24px;
        font-weight: 600;
    }

    .profile-name {
        font-family: var(--font-display);
        font-size: 18px;
        font-weight: 600;
        color: var(--text-900);
        margin: 0 0 3px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .profile-email {
        font-size: 12.5px;
        color: var(--text-400);
        margin: 0;
    }

    .info-row {
        display: flex;
        align-items: flex-start;
        gap: 14px;
        padding: 14px 0;
        border-bottom: 1px solid var(--line-soft);
    }

        .info-row:first-child {
            padding-top: 0;
        }

    .info-row__icon {
        width: 34px;
        height: 34px;
        border-radius: 9px;
        background: var(--accent-100);
        color: var(--accent-600);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .info-row__label {
        font-size: 11px;
        color: var(--text-400);
        margin-bottom: 2px;
    }

    .info-row__value {
        font-size: 14px;
        font-weight: 500;
        color: var(--text-900);
        line-height: 1.5;
    }

    .side-link {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 11px 10px;
        border-radius: 10px;
        text-decoration: none;
        color: var(--text-900);
        font-size: 13.5px;
        font-weight: 500;
        transition: background 0.15s ease;
    }

        .side-link:hover {
            background: var(--paper);
        }

    .side-link__icon {
        width: 30px;
        height: 30px;
        border-radius: 8px;
        background: var(--accent-100);
        color: var(--accent-600);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    @@media (max-width: 900px) {
        div[style*="grid-template-columns:2fr 1fr"] {
            grid-template-columns: 1fr !important;
        }
    }
</style>