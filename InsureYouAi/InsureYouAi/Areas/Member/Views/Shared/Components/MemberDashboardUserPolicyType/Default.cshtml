@using InsureYouAi.Areas.Member.ViewComponents.MemberDashboard
@{
    var breakdown = ViewBag.PolicyTypeBreakdown as List<PolicyTypeCountModel> ?? new List<PolicyTypeCountModel>();
    int totalCount = ViewBag.TotalCount is int t ? t : 0;
}

<div class="m-card">
    <div class="m-card__body">
        <h3 style="font-family:var(--font-display); font-size:15.5px; font-weight:600; margin:0 0 14px;">Poliçe Dağılımı</h3>

        @if (breakdown.Any())
        {
            <div style="display:flex; flex-direction:column; gap:10px;">
                @foreach (var pt in breakdown)
                {
                    var pct = totalCount > 0 ? (int)(pt.Count * 100.0 / totalCount) : 0;
                    <div>
                        <div style="display:flex; justify-content:space-between; font-size:12.5px; margin-bottom:5px;">
                            <span style="color:var(--text-900); font-weight:600;">@pt.PolicyType</span>
                            <span style="color:var(--text-400);">@pt.Count</span>
                        </div>
                        <div style="height:6px; background:var(--paper); border-radius:3px; overflow:hidden;">
                            <div style="height:100%; width:@(pct)%; background:var(--accent);"></div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <p style="font-size:13px; color:var(--text-400); margin:0;">Veri bulunmuyor.</p>
        }
    </div>
</div>