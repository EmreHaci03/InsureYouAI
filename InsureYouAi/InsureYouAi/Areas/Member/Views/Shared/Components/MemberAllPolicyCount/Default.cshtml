<div class="m-card stat-card">
    <div class="stat-card__icon" style="background:var(--paper); color:var(--text-600); border:1px solid var(--line);">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 11H5a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h4"></path>
            <path d="M9 11V7a4 4 0 0 1 8 0v4"></path>
            <path d="M9 11h10a2 2 0 0 1 2 2v7a2 2 0 0 1-2 2H9z"></path>
        </svg>
    </div>
    <div>
        <div class="stat-card__value">@ViewBag.PolicyCount</div>
        <div class="stat-card__label">Toplam Poliçe (Geçmiş Dahil)</div>
    </div>
</div>