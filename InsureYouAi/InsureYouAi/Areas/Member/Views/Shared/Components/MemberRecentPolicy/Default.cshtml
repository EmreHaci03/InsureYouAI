@model List<ResultPolicyDto>

<div style="display:flex; flex-direction:column; gap:2px;">

    @if (Model != null && Model.Any())
    {
        @foreach (var item in Model)
        {
            var isActive = (item.Status ?? "").Equals("Active", StringComparison.OrdinalIgnoreCase);
            var isExpired = item.EndDate < DateTime.Now;

            var badgeBg = isExpired ? "var(--danger-100)" : (isActive ? "var(--success-100)" : "var(--paper)");
            var badgeColor = isExpired ? "var(--danger)" : (isActive ? "var(--success)" : "var(--text-400)");
            var badgeText = isExpired ? "Süresi Doldu" : (isActive ? "Aktif" : item.Status);

            <div class="recent-row">
                <div style="display:flex; align-items:center; gap:12px; min-width:0;">
                    <div class="recent-row__icon">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--accent-600)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                        </svg>
                    </div>
                    <div style="min-width:0;">
                        <div style="font-size:13.5px; font-weight:600; color:var(--text-900); white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">
                            @item.PolicyType — #@item.PolicyNumber
                        </div>
                        <div style="font-size:11.5px; color:var(--text-400);">
                            @item.StartDate.ToString("dd MMM yyyy") – @item.EndDate.ToString("dd MMM yyyy")
                        </div>
                    </div>
                </div>
                <span class="m-badge" style="background:@badgeBg; color:@badgeColor;">@badgeText</span>
            </div>
        }
    }
    else
    {
        <div class="m-empty" style="padding:32px 0;">
            <p>Henüz kayıtlı bir poliçeniz görünmüyor.</p>
        </div>
    }

</div>