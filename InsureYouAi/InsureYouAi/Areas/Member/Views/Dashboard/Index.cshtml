@{
    Layout = "~/Areas/Member/Views/Shared/_MemberLayout.cshtml";
    ViewData["Title"] = "Panelim";
    var fullName = ViewBag.FullName ?? "Ziyaretçi";
}

<div class="m-page-head">
    <h1>Merhaba, @fullName 👋</h1>
    <p>Poliçelerinizin genel durumuna buradan göz atabilirsiniz.</p>
</div>

<div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(220px, 1fr)); gap:16px; margin-bottom:28px;">

   @await Component.InvokeAsync("MemberPolicyCount")

    @await Component.InvokeAsync("MemberDashboardPolicyAmount")

   @await Component.InvokeAsync("MemberDashboardUserArticle")

    @await Component.InvokeAsync("MemberAllPolicyCount")

</div>

<div style="display:grid; grid-template-columns:2fr 1fr; gap:20px; align-items:start;">

    <div class="m-card">
        <div class="m-card__body">
            <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:18px;">
                <h3 style="font-family:var(--font-display); font-size:17px; font-weight:600; margin:0;">Son Poliçeleriniz</h3>
                <a href="/MemberPolicies/MemberPolicyList/" style="font-size:12.5px; font-weight:600; color:var(--accent-600); text-decoration:none;">
                    Tümünü Gör →
                </a>
            </div>
            @await Component.InvokeAsync("MemberRecentPolicy")
        </div>
    </div>

    <div style="display:flex; flex-direction:column; gap:16px;">

        @await Component.InvokeAsync("MemberDashboardUserPolicyType")

        <div class="m-card" style="background:var(--ink-900); border-color:var(--ink-900);">
            <div class="m-card__body">
                <h3 style="font-family:var(--font-display); font-size:15.5px; font-weight:600; margin:0 0 8px; color:#fff;">
                    Yardıma mı ihtiyacınız var?
                </h3>
                <p style="font-size:12.5px; color:#9aa6ba; margin:0 0 16px; line-height:1.6;">
                    Poliçeleriniz hakkında sorularınız için 7/24 destek hattımıza ulaşabilirsiniz.
                </p>
                <a href="/Default/Index/" class="m-btn m-btn-accent" style="width:100%; justify-content:center;">İletişime Geç</a>
            </div>
        </div>

    </div>
</div>

<style>
    .stat-card {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 20px;
    }

    .stat-card__icon {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .stat-card__value {
        font-family: var(--font-display);
        font-size: 19px;
        font-weight: 600;
        color: var(--text-900);
        line-height: 1.2;
    }

    .stat-card__label {
        font-size: 12px;
        color: var(--text-400);
    }

    .recent-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 12px 0;
        border-bottom: 1px solid var(--line-soft);
    }

        .recent-row:last-child {
            border-bottom: none;
        }

    .recent-row__icon {
        width: 34px;
        height: 34px;
        border-radius: 9px;
        background: var(--accent-100);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    @@media (max-width: 900px) {
        div[style*="grid-template-columns:2fr 1fr"] {
            grid-template-columns: 1fr !important;
        }
    }
</style>