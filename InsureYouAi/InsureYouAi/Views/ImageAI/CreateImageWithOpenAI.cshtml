@model string
@{
    Layout = "/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "AI Görsel Oluştur";
}
<section style="max-width:700px; margin:40px auto; padding:0 20px;">
    <div style="background:#fff; border-radius:14px; padding:35px; box-shadow:0 5px 25px rgba(0,0,0,0.06);">
        <h2 style="font-size:22px; font-weight:700; color:#28314b; margin-bottom:24px;">AI ile Görsel Oluştur</h2>
        @if (TempData["ErrorMessage"] != null)
        {
            <div style="background:#fdeaea; color:#c0392b; padding:16px 20px; border-radius:8px; margin-bottom:20px; font-size:14px; word-break:break-word;">
                <strong>Hata:</strong> @TempData["ErrorMessage"]
            </div>
        }
        <form asp-controller="ImageAI" asp-action="CreateImageWithOpenAI" method="post">
            <div class="form-group" style="margin-bottom:20px;">
                <textarea name="prompt" rows="4" required placeholder="Görsel açıklaması yazın..."
                          style="width:100%; padding:14px 18px; border:1px solid #eceef4; border-radius:10px; background:#f9fafc; font-size:14px; box-sizing:border-box;"></textarea>
            </div>
            <button type="submit" style="padding:12px 28px; background:#ff5e14; color:#fff; border:none; border-radius:8px; font-weight:600; cursor:pointer;">
                Görsel Oluştur
            </button>
        </form>
        @if (!string.IsNullOrEmpty(Model))
        {
            var imageSrc = Model.StartsWith("http") ? Model : $"data:image/png;base64,{Model}";
            <div style="margin-top:30px;">
                <img src="@imageSrc" alt="Oluşturulan görsel" style="width:100%; border-radius:12px;" />
            </div>
        }
    </div>
</section>