@model LoginDto
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <title>Giriş Yap</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <style>
        body {
            font-family: 'Segoe UI', sans-serif;
            background: #f8f9fb;
        }

        .auth-wrapper {
            min-height: 100vh;
        }

        .auth-brand-side {
            background: linear-gradient(135deg, #6366f1, #8b5cf6 60%, #a855f7);
            position: relative;
            overflow: hidden;
        }

            .auth-brand-side::before {
                content: '';
                position: absolute;
                width: 400px;
                height: 400px;
                border-radius: 50%;
                background: rgba(255,255,255,0.08);
                top: -100px;
                right: -100px;
            }

            .auth-brand-side::after {
                content: '';
                position: absolute;
                width: 300px;
                height: 300px;
                border-radius: 50%;
                background: rgba(255,255,255,0.06);
                bottom: -80px;
                left: -80px;
            }

        .auth-form-card {
            max-width: 420px;
            width: 100%;
        }

        .form-control {
            border-radius: 12px;
            padding: 12px 16px;
            border: 1px solid #e5e7eb;
        }

            .form-control:focus {
                border-color: #8b5cf6;
                box-shadow: 0 0 0 3px rgba(139,92,246,0.15);
            }

        .btn-auth {
            background: linear-gradient(135deg, #6366f1, #8b5cf6);
            border: none;
            border-radius: 12px;
            padding: 12px;
            font-weight: 600;
            color: #fff;
            transition: all 0.2s ease;
        }

            .btn-auth:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 20px rgba(99,102,241,0.35);
                color: #fff;
            }

        .icon-badge {
            width: 60px;
            height: 60px;
            border-radius: 16px;
            background: rgba(255,255,255,0.15);
            display: flex;
            align-items: center;
            justify-content: center;
        }
    </style>
</head>
<body>
    <div class="d-flex auth-wrapper">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success">@TempData["SuccessMessage"]</div>
        }


        <!-- Sol taraf: marka / güven mesajı -->
        <div class="d-none d-lg-flex flex-column justify-content-between text-white p-5 auth-brand-side" style="width:45%;">
            <div>
                <div class="d-flex align-items-center gap-2">
                    <div class="icon-badge">
                        <i class="bi bi-shield-check fs-3"></i>
                    </div>
                    <h4 class="fw-bold mb-0">InsureYouAi</h4>
                </div>
            </div>

            <div class="position-relative">
                <h2 class="fw-bold mb-3">Güveniniz, Bizim Önceliğimiz</h2>
                <p class="opacity-75" style="font-size:1.05rem; line-height:1.7;">
                    Kasko, sağlık, konut ve daha fazlası — tüm sigorta ihtiyaçlarınızı tek panelden yönetin.
                    Hızlı, güvenli ve şeffaf bir deneyim sizi bekliyor.
                </p>
                <div class="d-flex gap-4 mt-4">
                    <div>
                        <h3 class="fw-bold mb-0">15+</h3>
                        <span class="opacity-75 small">Yıllık Tecrübe</span>
                    </div>
                    <div>
                        <h3 class="fw-bold mb-0">50K+</h3>
                        <span class="opacity-75 small">Mutlu Müşteri</span>
                    </div>
                    <div>
                        <h3 class="fw-bold mb-0">7/24</h3>
                        <span class="opacity-75 small">Destek</span>
                    </div>
                </div>
            </div>

            <p class="opacity-50 small mb-0">&copy; @DateTime.Now.Year InsureYouAi. Tüm hakları saklıdır.</p>
        </div>

        <!-- Sağ taraf: form -->
        <div class="d-flex flex-column align-items-center justify-content-center p-4" style="width:100%;">
            <div class="auth-form-card">

                <div class="text-center mb-4 d-lg-none">
                    <div class="rounded-4 d-inline-flex align-items-center justify-content-center mb-2"
                         style="width:56px; height:56px; background:linear-gradient(135deg,#6366f1,#8b5cf6);">
                        <i class="bi bi-shield-check text-white fs-3"></i>
                    </div>
                </div>

                <h3 class="fw-bold mb-1">Tekrar Hoş Geldiniz</h3>
                <p class="text-muted mb-4">Hesabınıza giriş yapın</p>

                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <form asp-action="Login"  method="post">
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Kullanıcı Adı</label>
                        <input asp-for="Username" class="form-control" placeholder="ornek@eposta.com" autofocus />
                        <span asp-validation-for="Username" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Şifre</label>
                        <input asp-for="Password" type="password" class="form-control" placeholder="••••••••" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="d-flex align-items-center justify-content-between mb-4">
                        <a href="javascript:;" class="small text-decoration-none" style="color:#6366f1;">Şifremi unuttum</a>
                    </div>

                    <button type="submit" class="btn btn-auth w-100 mb-3">
                        <i class="bi bi-box-arrow-in-right me-1"></i>Giriş Yap
                    </button>

                    <p class="text-center text-muted small mb-0">
                        Hesabınız yok mu?
                        <a asp-action="Register" class="text-decoration-none fw-semibold" style="color:#6366f1;">Kayıt Olun</a>
                    </p>
                </form>
            </div>
        </div>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>