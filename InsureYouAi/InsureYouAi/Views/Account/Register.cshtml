@model RegisterDto
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <title>Kayıt Ol</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <style>
        body {
            font-family: 'Segoe UI', sans-serif;
            background: #f8f9fb;
        }

        .auth-wrapper {
            min-height: 100vh;
        }

        .auth-brand-side {
            background: linear-gradient(135deg, #6366f1, #8b5cf6 60%, #a855f7);
            position: relative;
            overflow: hidden;
        }

            .auth-brand-side::before {
                content: '';
                position: absolute;
                width: 400px;
                height: 400px;
                border-radius: 50%;
                background: rgba(255,255,255,0.08);
                top: -100px;
                right: -100px;
            }

            .auth-brand-side::after {
                content: '';
                position: absolute;
                width: 300px;
                height: 300px;
                border-radius: 50%;
                background: rgba(255,255,255,0.06);
                bottom: -80px;
                left: -80px;
            }

        .auth-form-card {
            max-width: 440px;
            width: 100%;
        }

        .form-control {
            border-radius: 12px;
            padding: 12px 16px;
            border: 1px solid #e5e7eb;
        }

            .form-control:focus {
                border-color: #8b5cf6;
                box-shadow: 0 0 0 3px rgba(139,92,246,0.15);
            }

        .btn-auth {
            background: linear-gradient(135deg, #6366f1, #8b5cf6);
            border: none;
            border-radius: 12px;
            padding: 12px;
            font-weight: 600;
            color: #fff;
            transition: all 0.2s ease;
        }

            .btn-auth:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 20px rgba(99,102,241,0.35);
                color: #fff;
            }

        .icon-badge {
            width: 60px;
            height: 60px;
            border-radius: 16px;
            background: rgba(255,255,255,0.15);
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .feature-item {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 14px;
        }
    </style>
</head>
<body>
    <div class="d-flex auth-wrapper">

        <!-- Sol taraf: marka / özellikler -->
        <div class="d-none d-lg-flex flex-column justify-content-between text-white p-5 auth-brand-side" style="width:45%;">
            <div>
                <div class="d-flex align-items-center gap-2">
                    <div class="icon-badge">
                        <i class="bi bi-shield-check fs-3"></i>
                    </div>
                    <h4 class="fw-bold mb-0">InsureYouAi</h4>
                </div>
            </div>

            <div class="position-relative">
                <h2 class="fw-bold mb-4">Aramıza Katılın</h2>

                <div class="feature-item">
                    <i class="bi bi-check-circle-fill fs-5"></i>
                    <span>Poliçelerinizi tek yerden takip edin</span>
                </div>
                <div class="feature-item">
                    <i class="bi bi-check-circle-fill fs-5"></i>
                    <span>7/24 canlı destek ekibine erişin</span>
                </div>
                <div class="feature-item">
                    <i class="bi bi-check-circle-fill fs-5"></i>
                    <span>Hasar süreçlerinizi anlık izleyin</span>
                </div>
                <div class="feature-item">
                    <i class="bi bi-check-circle-fill fs-5"></i>
                    <span>Size özel avantajlı fiyatlar</span>
                </div>
            </div>

            <p class="opacity-50 small mb-0">&copy; @DateTime.Now.Year InsureYouAi. Tüm hakları saklıdır.</p>
        </div>

        <!-- Sağ taraf: form -->
        <div class="d-flex flex-column align-items-center justify-content-center p-4" style="width:100%;">
            <div class="auth-form-card">

                <div class="text-center mb-4 d-lg-none">
                    <div class="rounded-4 d-inline-flex align-items-center justify-content-center mb-2"
                         style="width:56px; height:56px; background:linear-gradient(135deg,#6366f1,#8b5cf6);">
                        <i class="bi bi-shield-check text-white fs-3"></i>
                    </div>
                </div>

                <h3 class="fw-bold mb-1">Hesap Oluşturun</h3>
                <p class="text-muted mb-4">Birkaç adımda üye olun</p>

                <div asp-validation-summary="All" class="text-danger small mb-3"></div>

                <form asp-action="Register" method="post">
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Ad</label>
                        <input asp-for="Name" class="form-control" placeholder="Adınız" autofocus />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Soyad</label>
                        <input asp-for="Surname" class="form-control" placeholder="Soyadınız" />
                        <span asp-validation-for="Surname" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Kullanıcı Adı</label>
                        <input asp-for="Username" class="form-control" placeholder="kullanici_adi" />
                        <span asp-validation-for="Username" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small">E-posta</label>
                        <input asp-for="Email" class="form-control" placeholder="ornek@eposta.com" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Şifre</label>
                        <input asp-for="Password" type="password" class="form-control" placeholder="En az 6 karakter" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold small">Şifre Tekrarı</label>
                        <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="••••••••" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-auth w-100 mb-3">
                        <i class="bi bi-person-plus-fill me-1"></i>Kayıt Ol
                    </button>

                    <p class="text-center text-muted small mb-0">
                        Zaten hesabınız var mı?
                        <a asp-action="Login" class="text-decoration-none fw-semibold" style="color:#6366f1;">Giriş Yapın</a>
                    </p>
                </form>
            </div>
        </div>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>