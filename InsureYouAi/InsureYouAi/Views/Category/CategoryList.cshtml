@model List<CategoryArticleCountViewModel>
@{
    Layout = "/Views/Shared/_AdminLayout.cshtml";
    string[] gradients = new[]
    {
        "linear-gradient(135deg,#6366f1,#8b5cf6)",
        "linear-gradient(135deg,#06b6d4,#3b82f6)",
        "linear-gradient(135deg,#f59e0b,#ef4444)",
        "linear-gradient(135deg,#10b981,#059669)",
        "linear-gradient(135deg,#ec4899,#f43f5e)",
        "linear-gradient(135deg,#8b5cf6,#6366f1)"
    };
}
@section BreadCrumb {
    <div class="page-breadcrumb d-none d-sm-flex align-items-center mb-3">
        <div class="breadcrumb-title pe-3"><i class="bi bi-tags-fill me-1"></i>Kategoriler</div>
        <div class="ps-3">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 p-0">
                    <li class="breadcrumb-item">
                        <a href="javascript:;"><i class="bx bx-home-alt"></i></a>
                    </li>
                    <li class="breadcrumb-item">
                        <a asp-action="CategoryList">Kategoriler</a>
                    </li>
                    <li class="breadcrumb-item active" aria-current="page">Kategori Listesi</li>
                </ol>
            </nav>
        </div>
    </div>
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-3 border-0 shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="d-flex flex-wrap align-items-center justify-content-between mb-4 gap-3">
    <div>
        <h4 class="fw-bold mb-1">Kategoriler <span class="badge rounded-pill bg-light text-dark ms-1">@(Model?.Count ?? 0)</span></h4>
        <p class="text-muted mb-0 small">Sigorta hizmetlerinizi kategorilere göre organize edin</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <div class="position-relative">
            <i class="bi bi-search position-absolute top-50 translate-middle-y ms-3 text-muted"></i>
            <input class="form-control ps-5 rounded-pill border-0 shadow-sm" type="text" placeholder="Kategori ara..." id="searchInput" style="min-width:240px;">
        </div>
        <a asp-action="CreateCategory" class="btn btn-primary rounded-pill px-4 shadow-sm">
            <i class="bi bi-plus-lg me-1"></i>Yeni Kategori
        </a>
    </div>
</div>

@if (Model != null && Model.Any())
{
    <div class="row g-3" id="categoryGrid">
        @for (int i = 0; i < Model.Count; i++)
        {
            var item = Model[i];
            var gradient = gradients[i % gradients.Length];
            var safeName = item.CategoryName ?? "";
            var initial = string.IsNullOrWhiteSpace(safeName) ? "?" : safeName.Trim()[0].ToString().ToUpper();

            <div class="col-xl-3 col-lg-4 col-md-6 category-card-wrap" data-name="@safeName.ToLower()">
                <div class="card border-0 shadow-sm h-100 category-card position-relative overflow-hidden">
                    <div class="position-absolute top-0 end-0 opacity-25" style="width:90px; height:90px; background:@gradient; border-radius:0 0 0 100%;"></div>

                    <div class="card-body position-relative">
                        <div class="dropdown position-absolute top-0 end-0 mt-2 me-2">
                            <button class="btn btn-sm btn-icon border-0 text-muted" type="button" data-bs-toggle="dropdown">
                                <i class="bi bi-three-dots-vertical"></i>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0">
                                <li>
                                    <a class="dropdown-item" asp-action="UpdateCategory" asp-route-id="@item.CategoryId">
                                        <i class="bi bi-pencil-fill me-2 text-warning"></i>Düzenle
                                    </a>
                                </li>
                                <li>
                                    <button type="button" class="dropdown-item text-danger btn-delete-category"
                                            data-id="@item.CategoryId" data-name="@safeName" data-gradient="@gradient" data-initial="@initial">
                                        <i class="bi bi-trash-fill me-2"></i>Sil
                                    </button>
                                </li>
                            </ul>
                        </div>

                        <div class="rounded-4 d-flex align-items-center justify-content-center mb-3 fw-bold text-white"
                             style="width:52px; height:52px; background:@gradient; font-size:20px;">
                            @initial
                        </div>

                        <h6 class="fw-semibold mb-1">@item.CategoryName</h6>
                        <span class="badge rounded-pill bg-light text-dark" style="font-size:11px; font-weight:600;">
                            <i class="bi bi-file-earmark-text me-1" style="color:#6366f1;"></i>@item.ArticleCount makale
                        </span>
                    </div>

                    <div class="card-footer bg-transparent border-top-0 pt-0 d-flex gap-2">
                        <a asp-action="UpdateCategory" asp-route-id="@item.CategoryId" class="text-decoration-none small fw-semibold flex-grow-1" style="color:#6366f1;">
                            Detayları Gör <i class="bi bi-arrow-right ms-1"></i>
                        </a>
                        <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-3 btn-delete-category"
                                data-id="@item.CategoryId" data-name="@safeName" data-gradient="@gradient" data-initial="@initial">
                            <i class="bi bi-trash-fill"></i>
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="card border-0 shadow-sm">
        <div class="card-body text-center py-5">
            <div class="rounded-circle bg-light d-inline-flex align-items-center justify-content-center mb-3" style="width:72px; height:72px;">
                <i class="bi bi-inbox fs-2 text-muted"></i>
            </div>
            <h6 class="fw-semibold">Henüz kategori eklenmemiş</h6>
            <p class="text-muted small">Başlamak için ilk kategorinizi oluşturun</p>
            <a asp-action="CreateCategory" class="btn btn-primary rounded-pill px-4 mt-2">
                <i class="bi bi-plus-lg me-1"></i>İlk Kategoriyi Ekle
            </a>
        </div>
    </div>
}

<form id="deleteForm" asp-action="DeleteCategory" method="post" class="d-none">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" id="deleteCategoryId" value="" />
</form>

<!-- Silme Onay Modalı -->
<div class="modal fade" id="deleteConfirmModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius:20px; overflow:hidden;">
            <div class="modal-body p-0">
                <div class="text-center pt-4 pb-2 px-4">
                    <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-3"
                         style="width:72px; height:72px; background:#fdeaea;">
                        <i class="bi bi-trash3-fill text-danger" style="font-size:28px;"></i>
                    </div>
                    <h5 class="fw-bold mb-1">Kategoriyi Sil</h5>
                    <p class="text-muted small mb-3">Bu işlem geri alınamaz. Devam etmek istediğinize emin misiniz?</p>
                </div>

                <div class="mx-4 mb-4 p-3 rounded-3 bg-light d-flex align-items-center gap-3" style="border-left:3px solid #dc3545;">
                    <div id="deleteCatAvatar" class="rounded-4 d-flex align-items-center justify-content-center fw-bold text-white flex-shrink-0"
                         style="width:44px; height:44px; font-size:16px;">
                        ?
                    </div>
                    <div class="min-w-0 text-start">
                        <h6 id="deleteCatName" class="fw-semibold mb-0"></h6>
                        <p class="text-muted small mb-0">Kategori</p>
                    </div>
                </div>

                <div class="d-flex gap-2 px-4 pb-4">
                    <button type="button" class="btn btn-light flex-grow-1 rounded-pill fw-semibold" data-bs-dismiss="modal">
                        Vazgeç
                    </button>
                    <button type="button" id="confirmDeleteCatBtn" class="btn btn-danger flex-grow-1 rounded-pill fw-semibold shadow-sm">
                        <i class="bi bi-trash3-fill me-1"></i>Evet, Sil
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .category-card {
        transition: all 0.25s ease;
        border-radius: 16px;
    }

        .category-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 24px rgba(0,0,0,0.08) !important;
        }

    .min-w-0 {
        min-width: 0;
    }

    #deleteConfirmModal .modal-content {
        animation: modalPopCat .25s ease;
    }

    @@keyframes modalPopCat {
        from {
            opacity: 0;
            transform: scale(.92);
        }

        to {
            opacity: 1;
            transform: scale(1);
        }
    }

    #confirmDeleteCatBtn:hover {
        background: #b02a37;
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function () {

        var searchInput = document.getElementById('searchInput');
        if (searchInput) {
            searchInput.addEventListener('input', function () {
                var term = this.value.toLowerCase();
                document.querySelectorAll('.category-card-wrap').forEach(function (card) {
                    card.style.display = card.dataset.name.includes(term) ? '' : 'none';
                });
            });
        }

        var deleteModalEl = document.getElementById('deleteConfirmModal');
        var deleteModal = new bootstrap.Modal(deleteModalEl);
        var pendingDeleteId = null;

        document.querySelectorAll('.btn-delete-category').forEach(function (btn) {
            btn.addEventListener('click', function () {
                pendingDeleteId = this.dataset.id;

                document.getElementById('deleteCatName').textContent = this.dataset.name;

                var avatar = document.getElementById('deleteCatAvatar');
                avatar.style.background = this.dataset.gradient;
                avatar.textContent = this.dataset.initial;

                deleteModal.show();
            });
        });

        document.getElementById('confirmDeleteCatBtn').addEventListener('click', function () {
            if (!pendingDeleteId) return;

            var btn = this;
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Siliniyor...';

            document.getElementById('deleteCategoryId').value = pendingDeleteId;
            document.getElementById('deleteForm').submit();
        });

    });
</script>
