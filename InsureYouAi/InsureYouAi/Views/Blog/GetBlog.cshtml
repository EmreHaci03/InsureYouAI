<section id="search-3" class="widget widget_search" style="background:#fff; border-radius:14px; padding:30px; box-shadow:0 5px 25px rgba(0,0,0,0.06); margin-bottom:30px;">
    <h2 class="widget-title" style="font-size:20px; font-weight:700; color:#28314b; margin-bottom:24px; padding-bottom:14px; border-bottom:2px solid #f4f5f9; position:relative;">
        Ara
        <span style="position:absolute; bottom:-2px; left:0; width:45px; height:2px; background:#ff5e14;"></span>
    </h2>
    <form role="search" method="get" class="search-form" action="#" style="position:relative;">
        <label style="display:block; margin:0;">
            <span class="screen-reader-text" style="position:absolute; left:-9999px;">Blog Ara:</span>
            <input type="search" class="search-field" placeholder="Aranacak kelimeler..." value="" name="s"
                   style="width:100%; padding:14px 55px 14px 18px; border:1px solid #eceef4; border-radius:10px; background:#f9fafc; font-size:14px; color:#28314b; outline:none; box-sizing:border-box; transition:border-color .2s, background .2s;"
                   onfocus="this.style.borderColor='#ff5e14'; this.style.background='#fff';"
                   onblur="this.style.borderColor='#eceef4'; this.style.background='#f9fafc';" />
        </label>
        <button type="submit" aria-label="Ara"
                style="position:absolute; top:50%; right:6px; transform:translateY(-50%); width:38px; height:38px; border:none; border-radius:8px; background:#ff5e14; color:#fff; display:flex; align-items:center; justify-content:center; cursor:pointer; transition:background .2s;"
                onmouseover="this.style.background='#28314b';" onmouseout="this.style.background='#ff5e14';">
            <i class="fal fa-search"></i>
        </button>
    </form>
</section>