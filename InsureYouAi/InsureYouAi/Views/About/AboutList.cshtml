@model List<ResultAboutDto>
@{
    Layout = "/Views/Shared/_AdminLayout.cshtml";
    string[] gradients = new[]
    {
        "linear-gradient(135deg,#6366f1,#8b5cf6)",
        "linear-gradient(135deg,#06b6d4,#3b82f6)",
        "linear-gradient(135deg,#f59e0b,#ef4444)",
        "linear-gradient(135deg,#10b981,#059669)",
        "linear-gradient(135deg,#ec4899,#f43f5e)",
        "linear-gradient(135deg,#8b5cf6,#6366f1)"
    };
}
@section BreadCrumb {
    <div class="page-breadcrumb d-none d-sm-flex align-items-center mb-3">
        <div class="breadcrumb-title pe-3"><i class="bi bi-info-circle-fill me-1"></i>Hakkımızda</div>
        <div class="ps-3">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 p-0">
                    <li class="breadcrumb-item">
                        <a href="javascript:;"><i class="bx bx-home-alt"></i></a>
                    </li>
                    <li class="breadcrumb-item">
                        <a asp-action="AboutList">Hakkımızda</a>
                    </li>
                    <li class="breadcrumb-item active" aria-current="page">Liste</li>
                </ol>
            </nav>
        </div>
    </div>
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-3 border-0 shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="d-flex flex-wrap align-items-center justify-content-between mb-4 gap-3">
    <div>
        <h4 class="fw-bold mb-1">Hakkımızda <span class="badge rounded-pill bg-light text-dark ms-1">@(Model?.Count ?? 0)</span></h4>
        <p class="text-muted mb-0 small">Hakkımızda içeriklerinizi yönetin</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <div class="position-relative">
            <i class="bi bi-search position-absolute top-50 translate-middle-y ms-3 text-muted"></i>
            <input class="form-control ps-5 rounded-pill border-0 shadow-sm" type="text" placeholder="Başlığa göre ara..." id="searchInput" style="min-width:240px;">
        </div>
        <a asp-action="CreateAbout" class="btn btn-primary rounded-pill px-4 shadow-sm">
            <i class="bi bi-plus-lg me-1"></i>Yeni Ekle
        </a>
        <a asp-action="CreateAboutWithGemini" class="btn rounded-pill px-4 shadow-sm text-white" style="background:linear-gradient(135deg,#8b5cf6,#6366f1); border:none;">
            <i class="bi bi-stars me-1"></i>Ai İle Oluştur
        </a>
    </div>
</div>

@if (Model != null && Model.Any())
{
    <div class="row g-3" id="aboutGrid">
        @for (int i = 0; i < Model.Count; i++)
        {
            var item = Model[i];
            var gradient = gradients[i % gradients.Length];
            var safeTitle = item.Title ?? "";

            <div class="col-xl-4 col-lg-6 about-card-wrap" data-name="@safeTitle.ToLower()">
                <div class="card border-0 shadow-sm h-100 about-card overflow-hidden">
                    <div class="position-relative">
                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                        {
                            <img src="@item.ImageUrl" class="w-100" style="height:180px; object-fit:cover;" alt="@safeTitle" />
                        }
                        else
                        {
                            <div class="w-100 d-flex align-items-center justify-content-center" style="height:180px; background:@gradient;">
                                <i class="bi bi-image text-white fs-1 opacity-75"></i>
                            </div>
                        }
                        <div class="dropdown position-absolute top-0 end-0 mt-2 me-2">
                            <button class="btn btn-sm btn-icon border-0 bg-white shadow-sm rounded-circle" type="button" data-bs-toggle="dropdown">
                                <i class="bi bi-three-dots-vertical"></i>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0">
                                <li>
                                    <a class="dropdown-item" asp-action="UpdateAbout" asp-route-id="@item.AboutId">
                                        <i class="bi bi-pencil-fill me-2 text-warning"></i>Düzenle
                                    </a>
                                </li>
                                <li>
                                    <button type="button" class="dropdown-item text-danger btn-delete-about"
                                            data-id="@item.AboutId" data-name="@safeTitle">
                                        <i class="bi bi-trash-fill me-2"></i>Sil
                                    </button>
                                </li>
                            </ul>
                        </div>
                    </div>

                    <div class="card-body">
                        <h6 class="fw-semibold mb-2">@item.Title</h6>
                        <p class="text-muted small mb-0">
                            @(item.Description?.Length > 100 ? item.Description.Substring(0, 100) + "..." : item.Description)
                        </p>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="card border-0 shadow-sm">
        <div class="card-body text-center py-5">
            <div class="rounded-circle bg-light d-inline-flex align-items-center justify-content-center mb-3" style="width:72px; height:72px;">
                <i class="bi bi-inbox fs-2 text-muted"></i>
            </div>
            <h6 class="fw-semibold">Henüz içerik eklenmemiş</h6>
            <p class="text-muted small">Başlamak için ilk içeriğinizi oluşturun</p>
            <a asp-action="CreateAbout" class="btn btn-primary rounded-pill px-4 mt-2">
                <i class="bi bi-plus-lg me-1"></i>İlk İçeriği Ekle
            </a>
        </div>
    </div>
}

<form id="deleteForm" asp-action="DeleteAbout" method="post" class="d-none">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" id="deleteAboutId" value="" />
</form>

<style>
    .about-card {
        transition: all 0.25s ease;
        border-radius: 16px;
    }

        .about-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 24px rgba(0,0,0,0.08) !important;
        }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function () {

        var searchInput = document.getElementById('searchInput');
        if (searchInput) {
            searchInput.addEventListener('input', function () {
                var term = this.value.toLowerCase();
                document.querySelectorAll('.about-card-wrap').forEach(function (card) {
                    card.style.display = card.dataset.name.includes(term) ? '' : 'none';
                });
            });
        }

        document.querySelectorAll('.btn-delete-about').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var id = this.dataset.id;
                var name = this.dataset.name;

                if (confirm('"' + name + '" içeriğini silmek istediğinize emin misiniz?')) {
                    document.getElementById('deleteAboutId').value = id;
                    document.getElementById('deleteForm').submit();
                }
            });
        });

    });
</script>