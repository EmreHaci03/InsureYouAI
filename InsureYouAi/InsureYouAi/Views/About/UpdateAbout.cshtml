@model UpdateAboutDto
@{
    Layout = "/Views/Shared/_AdminLayout.cshtml";
}
@section BreadCrumb {
    <div class="page-breadcrumb d-none d-sm-flex align-items-center mb-3">
        <div class="breadcrumb-title pe-3"><i class="bi bi-info-circle-fill me-1"></i>Hakkımızda</div>
        <div class="ps-3">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 p-0">
                    <li class="breadcrumb-item">
                        <a href="javascript:;"><i class="bx bx-home-alt"></i></a>
                    </li>
                    <li class="breadcrumb-item">
                        <a asp-action="AboutList">Hakkımızda</a>
                    </li>
                    <li class="breadcrumb-item active" aria-current="page">Düzenle</li>
                </ol>
            </nav>
        </div>
    </div>
}

<div class="row justify-content-center">
    <div class="col-xl-7 col-lg-9">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">

                <div class="d-flex align-items-center gap-3 mb-4">
                    <div class="rounded-4 d-flex align-items-center justify-content-center flex-shrink-0"
                         style="width:52px; height:52px; background:linear-gradient(135deg,#f59e0b,#ef4444);">
                        <i class="bi bi-pencil-fill text-white fs-5"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold mb-0">İçerik Düzenle</h5>
                        <p class="text-muted small mb-0">Hakkımızda içeriğini güncelleyin</p>
                    </div>
                </div>

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <form asp-action="UpdateAbout" method="post">
                    <input type="hidden" asp-for="AboutId" />

                    <div class="mb-4">
                        <label asp-for="Title" class="form-label fw-semibold">Başlık</label>
                        <input asp-for="Title" class="form-control rounded-3" autofocus />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Description" class="form-label fw-semibold">Açıklama</label>
                        <textarea asp-for="Description" class="form-control rounded-3" rows="5"></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ImageUrl" class="form-label fw-semibold">Görsel URL</label>
                        <input asp-for="ImageUrl" class="form-control rounded-3" onchange="previewImage(event)" />
                        <span asp-validation-for="ImageUrl" class="text-danger small"></span>
                        <div class="mt-3">
                            @if (!string.IsNullOrEmpty(Model.ImageUrl))
                            {
                                <img id="imagePreview" src="@Model.ImageUrl" class="rounded-3" style="max-height:180px; object-fit:cover;" />
                            }
                            else
                            {
                                <img id="imagePreview" class="rounded-3 d-none" style="max-height:180px; object-fit:cover;" />
                            }
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="AboutList" class="btn btn-light rounded-pill px-4">
                            Vazgeç
                        </a>
                        <button type="submit" class="btn btn-warning rounded-pill px-4 shadow-sm text-white">
                            <i class="bi bi-check-lg me-1"></i>Güncelle
                        </button>
                    </div>
                </form>

            </div>
        </div>
    </div>
</div>

<script>
    function previewImage(event) {
        var preview = document.getElementById('imagePreview');
        var url = event.target.value;
        if (url) {
            preview.src = url;
            preview.classList.remove('d-none');
        } else {
            preview.classList.add('d-none');
        }
    }
</script>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}