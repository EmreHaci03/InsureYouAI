@model RoleAssignViewModel
@{
    Layout = "/Views/Shared/_AdminLayout.cshtml";
}
@section BreadCrumb {
    <div class="page-breadcrumb d-none d-sm-flex align-items-center mb-3">
        <div class="breadcrumb-title pe-3"><i class="bi bi-shield-fill-check me-1"></i>Rol Atama</div>
        <div class="ps-3">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 p-0">
                    <li class="breadcrumb-item">
                        <a href="javascript:;"><i class="bx bx-home-alt"></i></a>
                    </li>
                    <li class="breadcrumb-item">
                        <a asp-controller="AppUser" asp-action="UserList">Kullanıcılar</a>
                    </li>
                    <li class="breadcrumb-item active" aria-current="page">Rol Ata</li>
                </ol>
            </nav>
        </div>
    </div>
}

<div class="row justify-content-center">
    <div class="col-xl-7 col-lg-9">

        <div class="text-center mb-4">
            <div class="rounded-4 d-inline-flex align-items-center justify-content-center mb-3"
                 style="width:64px; height:64px; background:linear-gradient(135deg,#10b981,#059669); box-shadow:0 8px 20px rgba(16,185,129,0.3);">
                <i class="bi bi-shield-fill-check text-white fs-3"></i>
            </div>
            <h4 class="fw-bold mb-1">Rol Ata</h4>
            <p class="text-muted small mb-0">
                <strong>@Model.UserName</strong> kullanıcısına atanacak rolleri seçin
            </p>
        </div>

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show rounded-3 border-0 shadow-sm" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <div class="card border-0 shadow-sm" style="border-radius:20px;">
            <div class="card-body p-4 p-md-5">
                <form asp-action="AssignRole" method="post">
                    <input type="hidden" asp-for="UserId" />
                    <input type="hidden" asp-for="UserName" />

                    @if (Model.roleChecks != null && Model.roleChecks.Any())
                    {
                        <div class="d-flex flex-column gap-2 mb-4">
                            @for (int i = 0; i < Model.roleChecks.Count; i++)
                            {
                                <label class="role-check-item d-flex align-items-center gap-3 p-3 rounded-3 border">
                                    <input type="hidden" asp-for="roleChecks[i].RoleId" />
                                    <input type="hidden" asp-for="roleChecks[i].RoleName" />
                                    <input type="checkbox" asp-for="roleChecks[i].IsSelected" class="form-check-input flex-shrink-0" style="width:20px; height:20px;">

                                    <div class="rounded-3 d-flex align-items-center justify-content-center flex-shrink-0"
                                         style="width:38px; height:38px; background:rgba(16,185,129,0.1);">
                                        <i class="bi bi-shield-lock-fill" style="color:#10b981;"></i>
                                    </div>

                                    <span class="fw-semibold">@Model.roleChecks[i].RoleName</span>
                                </label>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <p class="text-muted mb-0">Sistemde tanımlı rol bulunmuyor.</p>
                            <a asp-controller="Role" asp-action="CreateRole" class="btn btn-sm btn-outline-primary rounded-pill mt-2">
                                <i class="bi bi-plus-lg me-1"></i>Rol Oluştur
                            </a>
                        </div>
                    }

                    <div class="d-flex gap-2 pt-2">
                        <a asp-controller="AppUser" asp-action="UserList" class="btn btn-light rounded-pill px-4 flex-grow-1 fw-semibold">
                            <i class="bi bi-arrow-left me-1"></i>Vazgeç
                        </a>
                        <button type="submit" class="btn rounded-pill px-4 flex-grow-1 fw-semibold text-white"
                                style="background:linear-gradient(135deg,#10b981,#059669); border:none;">
                            <i class="bi bi-check-circle-fill me-1"></i>Kaydet
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    .role-check-item {
        transition: all 0.2s ease;
        border-color: #e5e7eb !important;
        cursor: pointer;
    }

        .role-check-item:hover {
            background: #f9fafb;
            border-color: #10b981 !important;
        }

        .role-check-item:has(input:checked) {
            background: rgba(16,185,129,0.06);
            border-color: #10b981 !important;
        }
</style>