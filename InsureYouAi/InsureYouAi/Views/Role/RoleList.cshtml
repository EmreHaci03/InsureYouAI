@model List<ResultAppRoleDto>
@{
    Layout = "/Views/Shared/_AdminLayout.cshtml";
}
@section BreadCrumb {
    <div class="page-breadcrumb d-none d-sm-flex align-items-center mb-3">
        <div class="breadcrumb-title pe-3"><i class="bi bi-shield-lock-fill me-1"></i>Roller</div>
        <div class="ps-3">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 p-0">
                    <li class="breadcrumb-item">
                        <a href="javascript:;"><i class="bx bx-home-alt"></i></a>
                    </li>
                    <li class="breadcrumb-item">
                        <a asp-action="RoleList">Roller</a>
                    </li>
                    <li class="breadcrumb-item active" aria-current="page">Liste</li>
                </ol>
            </nav>
        </div>
    </div>
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-3 border-0 shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="d-flex flex-wrap align-items-center justify-content-between mb-4 gap-3">
    <div>
        <h4 class="fw-bold mb-1">Roller <span class="badge rounded-pill bg-light text-dark ms-1">@(Model?.Count ?? 0)</span></h4>
        <p class="text-muted mb-0 small">Sistem içindeki kullanıcı rollerini yönetin</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <div class="position-relative">
            <i class="bi bi-search position-absolute top-50 translate-middle-y ms-3 text-muted"></i>
            <input class="form-control ps-5 rounded-pill border-0 shadow-sm" type="text" placeholder="Rol ara..." id="searchInput" style="min-width:240px;">
        </div>
        <a asp-action="CreateRole" class="btn btn-primary rounded-pill px-4 shadow-sm">
            <i class="bi bi-plus-lg me-1"></i>Yeni Rol
        </a>
    </div>
</div>

@if (Model != null && Model.Any())
{
    <div class="row g-3" id="roleGrid">
        @{
            string[] gradients = new[]
            {
        "linear-gradient(135deg,#6366f1,#8b5cf6)",
        "linear-gradient(135deg,#06b6d4,#3b82f6)",
        "linear-gradient(135deg,#f59e0b,#ef4444)",
        "linear-gradient(135deg,#10b981,#059669)",
        "linear-gradient(135deg,#ec4899,#f43f5e)"
        };
            int i = 0;
        }
        @foreach (var item in Model)
        {
            var gradient = gradients[i % gradients.Length];
            i++;
            var safeName = item.RoleName ?? "";

            <div class="col-xl-3 col-lg-4 col-md-6 role-card-wrap" data-name="@safeName.ToLower()">
                <div class="card border-0 shadow-sm h-100 role-card">
                    <div class="card-body p-4">
                        <div class="d-flex align-items-start justify-content-between mb-3">
                            <div class="rounded-4 d-flex align-items-center justify-content-center"
                                 style="width:48px; height:48px; background:@gradient;">
                                <i class="bi bi-shield-lock-fill text-white fs-5"></i>
                            </div>

                            <div class="dropdown">
                                <button class="btn btn-sm btn-icon border-0 text-muted" type="button" data-bs-toggle="dropdown">
                                    <i class="bi bi-three-dots-vertical"></i>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0">
                                    <li>
                                        <a class="dropdown-item" asp-action="UpdateRole" asp-route-id="@item.RoleId">
                                            <i class="bi bi-pencil-fill me-2 text-warning"></i>Düzenle
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-action="RoleUserList" asp-route-id="@item.RoleId">
                                            <i class="bi bi-people-fill me-2 text-primary"></i>Kullanıcıları Gör
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <button type="button" class="dropdown-item text-danger btn-delete-role"
                                                data-id="@item.RoleId" data-name="@safeName">
                                            <i class="bi bi-trash-fill me-2"></i>Sil
                                        </button>
                                    </li>
                                </ul>
                            </div>
                        </div>

                        <h6 class="fw-semibold mb-1">@item.RoleName</h6>
                        <p class="text-muted small mb-3">Rol ID: @item.RoleId</p>

                        @* <div class="d-flex align-items-center gap-2">
                            <span class="badge rounded-pill d-inline-flex align-items-center gap-1"
                                  style="background:#eef0ff; color:#4f46e5; font-weight:500; font-size:11.5px; padding:5px 10px;">
                                <i class="bi bi-people-fill"></i>@item.UserCount kullanıcı
                            </span>
                        </div> *@
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="card border-0 shadow-sm">
        <div class="card-body text-center py-5">
            <div class="rounded-circle bg-light d-inline-flex align-items-center justify-content-center mb-3" style="width:72px; height:72px;">
                <i class="bi bi-shield-lock fs-2 text-muted"></i>
            </div>
            <h6 class="fw-semibold">Henüz rol eklenmemiş</h6>
            <p class="text-muted small">Başlamak için ilk rolünüzü oluşturun</p>
            <a asp-action="CreateRole" class="btn btn-primary rounded-pill px-4 mt-2">
                <i class="bi bi-plus-lg me-1"></i>İlk Rolü Ekle
            </a>
        </div>
    </div>
}

<form id="deleteForm" asp-action="DeleteRole" method="post" class="d-none">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" id="deleteRoleId" value="" />
</form>

<style>
    .role-card {
        border-radius: 18px;
        transition: all 0.25s ease;
    }

        .role-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 24px rgba(0,0,0,0.08) !important;
        }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function () {

        var searchInput = document.getElementById('searchInput');
        if (searchInput) {
            searchInput.addEventListener('input', function () {
                var term = this.value.toLowerCase();
                document.querySelectorAll('.role-card-wrap').forEach(function (card) {
                    card.style.display = card.dataset.name.includes(term) ? '' : 'none';
                });
            });
        }

        document.querySelectorAll('.btn-delete-role').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var id = this.dataset.id;
                var name = this.dataset.name;

                if (confirm('"' + name + '" rolünü silmek istediğinize emin misiniz?')) {
                    document.getElementById('deleteRoleId').value = id;
                    document.getElementById('deleteForm').submit();
                }
            });
        });

    });
</script>