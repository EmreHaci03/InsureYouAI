@model List<ResultTestimonialDto>
@{
    Layout = "/Views/Shared/_AdminLayout.cshtml";
    string[] gradients = new[]
    {
        "linear-gradient(135deg,#6366f1,#8b5cf6)",
        "linear-gradient(135deg,#06b6d4,#3b82f6)",
        "linear-gradient(135deg,#f59e0b,#ef4444)",
        "linear-gradient(135deg,#10b981,#059669)",
        "linear-gradient(135deg,#ec4899,#f43f5e)",
    };
}
@section BreadCrumb {
    <div class="page-breadcrumb d-none d-sm-flex align-items-center mb-3">
        <div class="breadcrumb-title pe-3"><i class="bi bi-chat-quote-fill me-1"></i>Referanslar</div>
        <div class="ps-3">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 p-0">
                    <li class="breadcrumb-item">
                        <a href="javascript:;"><i class="bx bx-home-alt"></i></a>
                    </li>
                    <li class="breadcrumb-item">
                        <a asp-action="TestimonialList">Referanslar</a>
                    </li>
                    <li class="breadcrumb-item active" aria-current="page">Liste</li>
                </ol>
            </nav>
        </div>
    </div>
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-3 border-0 shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="d-flex flex-wrap align-items-center justify-content-between mb-4 gap-3">
    <div>
        <h4 class="fw-bold mb-1">Referanslar <span class="badge rounded-pill bg-light text-dark ms-1">@(Model?.Count ?? 0)</span></h4>
        <p class="text-muted mb-0 small">Müşteri yorumlarınızı yönetin</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <div class="position-relative">
            <i class="bi bi-search position-absolute top-50 translate-middle-y ms-3 text-muted"></i>
            <input class="form-control ps-5 rounded-pill border-0 shadow-sm" type="text" placeholder="Referans ara..." id="searchInput" style="min-width:240px;">
        </div>
        <a asp-action="CreateTestimonialWithClaude" class="btn rounded-pill px-4 shadow-sm text-white" style="background:linear-gradient(135deg,#d97757,#c15f3c); border:none;">
            <i class="bi bi-stars me-1"></i>Claude İle Oluştur
        </a>
        <a asp-action="CreateTestimonial" class="btn btn-primary rounded-pill px-4 shadow-sm">
            <i class="bi bi-plus-lg me-1"></i>Yeni Referans
        </a>
    </div>
</div>

@if (Model != null && Model.Any())
{
    <div class="row g-3" id="testimonialGrid">
        @for (int i = 0; i < Model.Count; i++)
        {
            var item = Model[i];
            var gradient = gradients[i % gradients.Length];
            var safeTitle = item.Title ?? "";
            var initial = string.IsNullOrWhiteSpace(safeTitle) ? "?" : safeTitle.Trim()[0].ToString().ToUpper();
            var preview = item.CommentDetail?.Length > 140 ? item.CommentDetail.Substring(0, 140) + "…" : item.CommentDetail;

            <div class="col-xl-4 col-lg-6 testimonial-card-wrap" data-name="@safeTitle.ToLower()">
                <div class="card border-0 shadow-sm h-100 testimonial-card position-relative overflow-hidden">
                    <div class="position-absolute top-0 end-0 opacity-25" style="width:90px; height:90px; background:@gradient; border-radius:0 0 0 100%;"></div>

                    <div class="dropdown position-absolute top-0 end-0 mt-3 me-3" style="z-index:2;">
                        <button class="btn btn-sm btn-icon border-0 text-muted" type="button" data-bs-toggle="dropdown">
                            <i class="bi bi-three-dots-vertical"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0">
                            <li>
                                <a class="dropdown-item" asp-action="UpdateTestimonial" asp-route-id="@item.TestimonialId">
                                    <i class="bi bi-pencil-fill me-2 text-warning"></i>Düzenle
                                </a>
                            </li>
                            <li>
                                <button type="button" class="dropdown-item text-danger btn-delete-testimonial"
                                        data-id="@item.TestimonialId" data-name="@safeTitle" data-preview="@preview" data-gradient="@gradient" data-initial="@initial" data-image="@item.ImageUrl">
                                    <i class="bi bi-trash-fill me-2"></i>Sil
                                </button>
                            </li>
                        </ul>
                    </div>

                    <div class="card-body p-4 position-relative d-flex flex-column">
                        <i class="bi bi-quote fs-1 opacity-25 mb-2 d-block" style="color:#6366f1;"></i>

                        <p class="mb-4 flex-grow-1" style="line-height:1.7; min-height:75px;">
                            @preview
                        </p>

                        <div class="d-flex align-items-center gap-3 pt-3" style="border-top:1px solid #f4f5f9;">
                            @if (!string.IsNullOrEmpty(item.ImageUrl))
                            {
                                <img src="@item.ImageUrl" class="rounded-circle" style="width:48px; height:48px; object-fit:cover; border:2px solid #fff; box-shadow:0 3px 10px rgba(0,0,0,0.1);" alt="@safeTitle" />
                            }
                            else
                            {
                                <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0 fw-semibold text-white"
                                     style="width:48px; height:48px; background:@gradient; font-size:16px; box-shadow:0 3px 10px rgba(0,0,0,0.1);">
                                    @initial
                                </div>
                            }
                            <div>
                                <p class="mb-0 fw-semibold">@item.Title</p>
                                <span class="text-muted small d-flex align-items-center gap-1">
                                    <i class="bi bi-patch-check-fill" style="color:#28a745; font-size:11px;"></i>Doğrulanmış Müşteri
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="card border-0 shadow-sm">
        <div class="card-body text-center py-5">
            <div class="rounded-circle bg-light d-inline-flex align-items-center justify-content-center mb-3" style="width:72px; height:72px;">
                <i class="bi bi-inbox fs-2 text-muted"></i>
            </div>
            <h6 class="fw-semibold">Henüz referans eklenmemiş</h6>
            <p class="text-muted small">Başlamak için ilk referansınızı oluşturun</p>
            <a asp-action="CreateTestimonial" class="btn btn-primary rounded-pill px-4 mt-2">
                <i class="bi bi-plus-lg me-1"></i>İlk Referansı Ekle
            </a>
        </div>
    </div>
}

<form id="deleteForm" asp-action="DeleteTestimonial" method="post" class="d-none">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" id="deleteTestimonialId" value="" />
</form>

<!-- Silme Onay Modalı -->
<div class="modal fade" id="deleteConfirmModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius:20px; overflow:hidden;">
            <div class="modal-body p-0">
                <div class="text-center pt-4 pb-2 px-4">
                    <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-3"
                         style="width:72px; height:72px; background:#fdeaea;">
                        <i class="bi bi-trash3-fill text-danger" style="font-size:28px;"></i>
                    </div>
                    <h5 class="fw-bold mb-1">Referansı Sil</h5>
                    <p class="text-muted small mb-3">Bu işlem geri alınamaz. Devam etmek istediğinize emin misiniz?</p>
                </div>

                <div class="mx-4 mb-4 p-3 rounded-3 bg-light" style="border-left:3px solid #dc3545;">
                    <div class="d-flex align-items-center gap-3 mb-2">
                        <img id="deleteTestimonialImg" src="" style="width:38px; height:38px; border-radius:50%; object-fit:cover; display:none;" />
                        <div id="deleteTestimonialAvatar" class="rounded-circle d-flex align-items-center justify-content-center fw-bold text-white flex-shrink-0"
                             style="width:38px; height:38px; font-size:14px;">
                            ?
                        </div>
                        <h6 id="deleteTestimonialName" class="fw-semibold mb-0 small"></h6>
                    </div>
                    <p id="deleteTestimonialPreview" class="text-muted small mb-0" style="line-height:1.5;"></p>
                </div>

                <div class="d-flex gap-2 px-4 pb-4">
                    <button type="button" class="btn btn-light flex-grow-1 rounded-pill fw-semibold" data-bs-dismiss="modal">
                        Vazgeç
                    </button>
                    <button type="button" id="confirmDeleteTestimonialBtn" class="btn btn-danger flex-grow-1 rounded-pill fw-semibold shadow-sm">
                        <i class="bi bi-trash3-fill me-1"></i>Evet, Sil
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .testimonial-card {
        transition: all 0.25s ease;
        border-radius: 16px;
    }

        .testimonial-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 24px rgba(0,0,0,0.08) !important;
        }

    #deleteConfirmModal .modal-content {
        animation: modalPopTest .25s ease;
    }

    @@keyframes modalPopTest {
        from {
            opacity: 0;
            transform: scale(.92);
        }

        to {
            opacity: 1;
            transform: scale(1);
        }
    }

    #confirmDeleteTestimonialBtn:hover {
        background: #b02a37;
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function () {

        var searchInput = document.getElementById('searchInput');
        if (searchInput) {
            searchInput.addEventListener('input', function () {
                var term = this.value.toLowerCase();
                document.querySelectorAll('.testimonial-card-wrap').forEach(function (card) {
                    card.style.display = card.dataset.name.includes(term) ? '' : 'none';
                });
            });
        }

        var deleteModalEl = document.getElementById('deleteConfirmModal');
        var deleteModal = new bootstrap.Modal(deleteModalEl);
        var pendingDeleteId = null;

        document.querySelectorAll('.btn-delete-testimonial').forEach(function (btn) {
            btn.addEventListener('click', function () {
                pendingDeleteId = this.dataset.id;

                document.getElementById('deleteTestimonialName').textContent = this.dataset.name;
                document.getElementById('deleteTestimonialPreview').textContent = this.dataset.preview;

                var img = document.getElementById('deleteTestimonialImg');
                var avatar = document.getElementById('deleteTestimonialAvatar');
                var imageUrl = this.dataset.image;

                if (imageUrl) {
                    img.src = imageUrl;
                    img.style.display = 'block';
                    avatar.style.display = 'none';
                } else {
                    img.style.display = 'none';
                    avatar.style.display = 'flex';
                    avatar.style.background = this.dataset.gradient;
                    avatar.textContent = this.dataset.initial;
                }

                deleteModal.show();
            });
        });

        document.getElementById('confirmDeleteTestimonialBtn').addEventListener('click', function () {
            if (!pendingDeleteId) return;

            var btn = this;
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Siliniyor...';

            document.getElementById('deleteTestimonialId').value = pendingDeleteId;
            document.getElementById('deleteForm').submit();
        });

    });
</script>
