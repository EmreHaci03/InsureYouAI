@model List<ResultContactDto>
@{
    Layout = "/Views/Shared/_AdminLayout.cshtml";
}
@section BreadCrumb {
    <div class="page-breadcrumb d-none d-sm-flex align-items-center mb-3">
        <div class="breadcrumb-title pe-3"><i class="bi bi-person-lines-fill me-1"></i>İletişim Bilgileri</div>
        <div class="ps-3">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 p-0">
                    <li class="breadcrumb-item">
                        <a href="javascript:;"><i class="bx bx-home-alt"></i></a>
                    </li>
                    <li class="breadcrumb-item">
                        <a asp-action="ContactList">İletişim</a>
                    </li>
                    <li class="breadcrumb-item active" aria-current="page">Liste</li>
                </ol>
            </nav>
        </div>
    </div>
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-3 border-0 shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="d-flex flex-wrap align-items-center justify-content-between mb-4 gap-3">
    <div>
        <h4 class="fw-bold mb-1">İletişim Bilgileri <span class="badge rounded-pill bg-light text-dark ms-1">@(Model?.Count ?? 0)</span></h4>
        <p class="text-muted mb-0 small">Telefon, e-posta ve adres bilgilerinizi yönetin</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <div class="position-relative">
            <i class="bi bi-search position-absolute top-50 translate-middle-y ms-3 text-muted"></i>
            <input class="form-control ps-5 rounded-pill border-0 shadow-sm" type="text" placeholder="Ara..." id="searchInput" style="min-width:240px;">
        </div>
        <a asp-action="CreateContact" class="btn btn-primary rounded-pill px-4 shadow-sm">
            <i class="bi bi-plus-lg me-1"></i>Yeni Ekle
        </a>
    </div>
</div>

@if (Model != null && Model.Any())
{
    <div class="row g-3" id="contactGrid">
        @foreach (var item in Model)
        {
            var safeDesc = item.Description ?? "";
            var searchKey = $"{safeDesc} {item.PhoneNumber} {item.Email} {item.Adress}".ToLower();

            <div class="col-xl-4 col-lg-6 contact-card-wrap" data-name="@searchKey">
                <div class="card border-0 shadow-sm h-100 contact-card position-relative overflow-hidden">
                    <div class="card-body">
                        <div class="d-flex align-items-start justify-content-between mb-3">
                            <div class="rounded-4 d-flex align-items-center justify-content-center flex-shrink-0"
                                 style="width:48px; height:48px; background:linear-gradient(135deg,#6366f1,#8b5cf6);">
                                <i class="bi bi-person-lines-fill text-white fs-5"></i>
                            </div>
                            <div class="dropdown">
                                <button class="btn btn-sm btn-icon border-0 text-muted" type="button" data-bs-toggle="dropdown">
                                    <i class="bi bi-three-dots-vertical"></i>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0">
                                    <li>
                                        <a class="dropdown-item" asp-action="UpdateContact" asp-route-id="@item.ContactId">
                                            <i class="bi bi-pencil-fill me-2 text-warning"></i>Düzenle
                                        </a>
                                    </li>
                                    <li>
                                        <button type="button" class="dropdown-item text-danger btn-delete-contact"
                                                data-id="@item.ContactId" data-name="@safeDesc">
                                            <i class="bi bi-trash-fill me-2"></i>Sil
                                        </button>
                                    </li>
                                </ul>
                            </div>
                        </div>

                        <p class="fw-semibold mb-3">@(string.IsNullOrEmpty(safeDesc) ? "İletişim Bilgisi" : safeDesc)</p>

                        <ul class="list-unstyled mb-0 small">
                            <li class="d-flex align-items-center gap-2 mb-2 text-muted">
                                <i class="bi bi-telephone-fill text-primary"></i>@item.PhoneNumber
                            </li>
                            <li class="d-flex align-items-center gap-2 mb-2 text-muted">
                                <i class="bi bi-envelope-fill text-primary"></i>@item.Email
                            </li>
                            <li class="d-flex align-items-start gap-2 text-muted">
                                <i class="bi bi-geo-alt-fill text-primary mt-1"></i>
                                <span>@item.Adress</span>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="card border-0 shadow-sm">
        <div class="card-body text-center py-5">
            <div class="rounded-circle bg-light d-inline-flex align-items-center justify-content-center mb-3" style="width:72px; height:72px;">
                <i class="bi bi-inbox fs-2 text-muted"></i>
            </div>
            <h6 class="fw-semibold">Henüz iletişim bilgisi eklenmemiş</h6>
            <p class="text-muted small">Başlamak için ilk kaydınızı oluşturun</p>
            <a asp-action="CreateContact" class="btn btn-primary rounded-pill px-4 mt-2">
                <i class="bi bi-plus-lg me-1"></i>İlk Kaydı Ekle
            </a>
        </div>
    </div>
}

<form id="deleteForm" asp-action="DeleteContact" method="post" class="d-none">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" id="deleteContactId" value="" />
</form>

<style>
    .contact-card {
        transition: all 0.25s ease;
        border-radius: 16px;
    }

        .contact-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 24px rgba(0,0,0,0.08) !important;
        }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function () {

        var searchInput = document.getElementById('searchInput');
        if (searchInput) {
            searchInput.addEventListener('input', function () {
                var term = this.value.toLowerCase();
                document.querySelectorAll('.contact-card-wrap').forEach(function (card) {
                    card.style.display = card.dataset.name.includes(term) ? '' : 'none';
                });
            });
        }

        document.querySelectorAll('.btn-delete-contact').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var id = this.dataset.id;
                var name = this.dataset.name;

                if (confirm('"' + name + '" kaydını silmek istediğinize emin misiniz?')) {
                    document.getElementById('deleteContactId').value = id;
                    document.getElementById('deleteForm').submit();
                }
            });
        });

    });
</script>