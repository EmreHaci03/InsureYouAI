@model CreateContactDto
@{
    Layout = "/Views/Shared/_AdminLayout.cshtml";
}
@section BreadCrumb {
    <div class="page-breadcrumb d-none d-sm-flex align-items-center mb-3">
        <div class="breadcrumb-title pe-3"><i class="bi bi-person-lines-fill me-1"></i>İletişim Bilgileri</div>
        <div class="ps-3">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 p-0">
                    <li class="breadcrumb-item">
                        <a href="javascript:;"><i class="bx bx-home-alt"></i></a>
                    </li>
                    <li class="breadcrumb-item">
                        <a asp-action="ContactList">İletişim</a>
                    </li>
                    <li class="breadcrumb-item active" aria-current="page">Yeni Ekle</li>
                </ol>
            </nav>
        </div>
    </div>
}

<div class="row justify-content-center">
    <div class="col-xl-6 col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">

                <div class="d-flex align-items-center gap-3 mb-4">
                    <div class="rounded-4 d-flex align-items-center justify-content-center flex-shrink-0"
                         style="width:52px; height:52px; background:linear-gradient(135deg,#6366f1,#8b5cf6);">
                        <i class="bi bi-person-lines-fill text-white fs-5"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold mb-0">Yeni İletişim Bilgisi</h5>
                        <p class="text-muted small mb-0">İletişim kaydı oluşturun</p>
                    </div>
                </div>

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <form asp-action="CreateContact" method="post">
                    <div class="mb-4">
                        <label asp-for="Description" class="form-label fw-semibold">Açıklama</label>
                        <input asp-for="Description" class="form-control rounded-3" placeholder="Örn: Merkez Ofis" autofocus />
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="PhoneNumber" class="form-label fw-semibold">Telefon</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-0 rounded-start-3"><i class="bi bi-telephone-fill text-primary"></i></span>
                            <input asp-for="PhoneNumber" class="form-control rounded-end-3" placeholder="0212 000 00 00" />
                        </div>
                        <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Email" class="form-label fw-semibold">E-posta</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-0 rounded-start-3"><i class="bi bi-envelope-fill text-primary"></i></span>
                            <input asp-for="Email" type="email" class="form-control rounded-end-3" placeholder="info@ornek.com" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Adress" class="form-label fw-semibold">Adres</label>
                        <textarea asp-for="Adress" class="form-control rounded-3" rows="3" placeholder="Açık adres..."></textarea>
                        <span asp-validation-for="Adress" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="ContactList" class="btn btn-light rounded-pill px-4">
                            Vazgeç
                        </a>
                        <button type="submit" class="btn btn-primary rounded-pill px-4 shadow-sm">
                            <i class="bi bi-check-lg me-1"></i>Kaydet
                        </button>
                    </div>
                </form>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}