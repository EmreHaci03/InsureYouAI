@model List<ResultSliderDto>
<section id="parallax" class="slider-area fix p-relative">
    <div class="slider-shape ss-one layer" data-depth="0.10"><img src="~/defaultimages/slider_shape01.png" alt="shape"></div>
    <div class="slider-shape ss-two layer" data-depth="0.30"><img src="~/defaultimages/slider_shape02.png" alt="shape"></div>
    <div class="slider-shape ss-three layer" data-depth="0.40"><img src="~/defaultimages/slider_shape03.png" alt="shape"></div>
    <div class="slider-active" style="background: #fff;">
        @foreach (var item in Model)
        {
            <div class="single-slider slider-bg d-flex align-items-center" style="
                    background-image: linear-gradient(135deg, rgba(20,25,45,0.55), rgba(255,94,20,0.25)), url('@item.ImageUrl');
                    background-size: cover;
                    background-position: center;
                    background-repeat: no-repeat;
                    ">
                <div class="container">
                    <div class="row justify-content-center align-items-center">
                        <div class="col-lg-7 col-md-7">
                            <div class="slider-content s-slider-content mt-100">
                                <h5 data-animation="fadeInUp" data-delay=".4s" style="color:#fff; opacity:.9;">Hoşgeldiniz <span style="color:#ff5e14;">InsureYou</span></h5>
                                <h2 data-animation="fadeInUp" data-delay=".4s" style="color:#fff; text-shadow:0 2px 20px rgba(0,0,0,0.3);">İhtiyacınız <span style="color:#ff5e14;">Olan</span> Her Şey Burada Mevcut</h2>
                                <p data-animation="fadeInUp" data-delay=".6s" style="color:rgba(255,255,255,0.85); font-size:15px; line-height:1.8; max-width:520px;">@item.Description</p>
                                <div class="slider-btn mt-30 mb-105">
                                    <a href="/Default/Contact" class="btn ss-btn mr-15" data-animation="fadeInLeft" data-delay=".4s"
                                       style="display:inline-flex; align-items:center; gap:8px; padding:15px 32px; background:#ff5e14; color:#fff; border-radius:10px; font-weight:700; text-decoration:none; transition:background .25s ease;"
                                       onmouseover="this.style.background='#fff'; this.style.color='#28314b';" onmouseout="this.style.background='#ff5e14'; this.style.color='#fff';">
                                        Daha Fazlası <i class="fal fa-arrow-right"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-5 col-md-5 p-relative">
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</section>