@model GetArticleByIdDto
<div class="details__content pb-30" style="background:#fff; border-radius:16px; padding:40px; box-shadow:0 5px 25px rgba(0,0,0,0.06);">
    <h2 style="font-size:28px; font-weight:700; color:#28314b; line-height:1.4; margin-bottom:20px;">
        @Model.Title
    </h2>
    <div class="meta-info" style="margin-bottom:28px; padding-bottom:24px; border-bottom:1px solid #f4f5f9;">
        <ul style="display:flex; gap:24px; list-style:none; padding:0; margin:0; flex-wrap:wrap;">
            <li style="color:#8891ac; font-size:14px; display:flex; align-items:center; gap:6px;">
                <i class="fal fa-user" style="color:#ff5e14;"></i> @Model.User
            </li>
            <li style="color:#8891ac; font-size:14px; display:flex; align-items:center; gap:6px;">
                <i class="fal fa-calendar-alt" style="color:#ff5e14;"></i> @Model.CreatedDate.ToString("dd MMMM yyyy")
            </li>
            @if (!string.IsNullOrEmpty(Model.Category))
            {
                <li style="color:#8891ac; font-size:14px; display:flex; align-items:center; gap:6px;">
                    <i class="fal fa-folder" style="color:#ff5e14;"></i> @Model.Category
                </li>
            }
        </ul>
    </div>
    @if (!string.IsNullOrEmpty(Model.CoverImageUrl))
    {
        <div class="details__content-img mb-30" style="border-radius:14px; overflow:hidden; height:420px;">
            <img src="@Model.CoverImageUrl" alt="@Model.Title" style="width:100%; height:100%; object-fit:cover; display:block;">
        </div>
    }
    <div class="article-body" style="color:#4b5468; font-size:15.5px; line-height:1.9;">
        @Html.Raw(Model.Content)
    </div>
</div>
<style>
    .article-body h2, .article-body h3 {
        color: #28314b;
        font-weight: 700;
        margin-top: 30px;
        margin-bottom: 14px;
    }

    .article-body h2 {
        font-size: 22px;
    }

    .article-body h3 {
        font-size: 18px;
    }

    .article-body p {
        margin-bottom: 18px;
    }

    .article-body img {
        max-width: 100%;
        border-radius: 12px;
        margin: 20px 0;
    }

    .article-body blockquote {
        background: #f9fafc;
        border-left: 4px solid #ff5e14;
        padding: 20px 25px;
        border-radius: 10px;
        margin: 25px 0;
        font-style: italic;
        color: #28314b;
    }

    @@media (max-width: 576px) {
        .details__content-img {
            height: 260px !important;
        }
    }
</style>