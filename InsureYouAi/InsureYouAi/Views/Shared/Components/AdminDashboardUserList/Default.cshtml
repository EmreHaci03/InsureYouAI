@model List<ResultAppUserDto>

<div class="col-12 col-lg-6 col-xl-6 d-flex">
    <div class="card rounded-4 w-100">
        <div class="card-body">
            <div class="d-flex align-items-center mb-3">
                <h6 class="mb-0">Son Kayıt Olan Kullanıcılar</h6>
                <a href="/AppUser/UserList" class="ms-auto small fw-semibold text-decoration-none" style="color:#6366f1;">
                    Tümünü Gör
                </a>
            </div>

            @if (Model != null && Model.Any())
            {
                @foreach (var item in Model)
                {
                    var fullName = $"{item.Name} {item.SurName}".Trim();
                    var safeName = string.IsNullOrWhiteSpace(fullName) ? "İsimsiz Kullanıcı" : fullName;
                    var initial = string.IsNullOrWhiteSpace(item.Name) ? "?" : item.Name.Trim()[0].ToString().ToUpper();
                    var hasImage = !string.IsNullOrWhiteSpace(item.ImageUrl);

                    <div class="d-flex align-items-center gap-3 mb-3">
                        @if (hasImage)
                        {
                            <img src="@item.ImageUrl" alt="@safeName" class="rounded-circle" style="width:44px; height:44px; object-fit:cover; flex-shrink:0;">
                        }
                        else
                        {
                            <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold text-white flex-shrink-0"
                                 style="width:44px; height:44px; background:linear-gradient(135deg,#6366f1,#8b5cf6); font-size:16px;">
                                @initial
                            </div>
                        }
                        <div class="flex-grow-1" style="min-width:0;">
                            <p class="mb-0 small fw-semibold text-truncate">@safeName</p>
                            <span class="text-muted" style="font-size:11.5px;">
                                @(string.IsNullOrWhiteSpace(item.Description) ? "Açıklama girilmemiş" : item.Description)
                            </span>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="text-center py-4">
                    <i class="bi bi-people" style="font-size:28px; color:#c3c2b7;"></i>
                    <p class="text-muted small mb-0 mt-2">Henüz kullanıcı bulunmuyor</p>
                </div>
            }
        </div>
    </div>
</div>