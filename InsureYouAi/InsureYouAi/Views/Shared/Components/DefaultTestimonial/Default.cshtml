@model List<ResultTestimonialDto>
<section id="testimonial" class="testimonial-area pt-120 pb-30 p-relative fix" style="background-color: #28314b; position:relative; overflow:hidden;">
    <div style="position:absolute; top:-80px; right:-80px; width:280px; height:280px; border-radius:50%; background:rgba(255,94,20,0.08); filter:blur(20px);"></div>
    <div style="position:absolute; bottom:-100px; left:-60px; width:220px; height:220px; border-radius:50%; background:rgba(255,255,255,0.03);"></div>

    <div class="container" style="position:relative; z-index:2;">
        <div class="row">
            <div class="col-lg-12">
                <div class="section-title center-align mb-50 text-center" data-aos="fade-up" data-aos-duration="1000">
                    <span style="display:inline-flex; align-items:center; gap:8px; background:rgba(255,94,20,0.15); color:#ff8c4d; padding:6px 16px; border-radius:30px; font-size:12.5px; font-weight:600; letter-spacing:.5px; margin-bottom:16px; border:1px solid rgba(255,94,20,0.3);">
                        <i class="fal fa-comment-heart"></i> Referanslar
                    </span>
                    <h2 style="color:#fff; font-size:32px; font-weight:700; margin:0;">Müşterilerimiz Ne Diyor</h2>
                </div>
            </div>
            <div class="col-lg-12">
                <div class="testimonial-active" data-aos="fade-up" data-aos-duration="1400">
                    @foreach (var item in Model)
                    {
                        <div class="single-testimonial testimonial-card" style="background:#323b57; border-radius:16px; padding:35px 30px; margin:10px; position:relative; transition:transform .3s ease, box-shadow .3s ease; border:1px solid rgba(255,255,255,0.06);"
                             onmouseover="this.style.transform='translateY(-6px)'; this.style.boxShadow='0 20px 40px rgba(0,0,0,0.25)';"
                             onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='none';">
                            <div class="qt-img" style="margin-bottom:15px; opacity:.85;">
                                <img src="~/insureyou/img/testimonial/qt-icon.png" alt="img" style="width:34px;">
                            </div>
                            <p style="color:#c9cddb; line-height:1.8; min-height:110px; font-size:14.5px;">"@item.CommentDetail"</p>
                            <div class="testi-author" style="display:flex; align-items:center; gap:15px; margin-top:25px; border-top:1px solid rgba(255,255,255,0.1); padding-top:20px;">
                                <img src="@item.ImageUrl" alt="@item.Title" style="width:56px; height:56px; min-width:56px; border-radius:50%; object-fit:cover; border:2px solid #ff5e14;">
                                <div class="ta-info">
                                    <h6 style="color:#fff; margin:0; font-size:15px; font-weight:700;">@item.Title</h6>
                                    <span style="color:#8891ac; font-size:12.5px; display:flex; align-items:center; gap:5px;">
                                        <i class="fal fa-badge-check" style="color:#ff5e14; font-size:11px;"></i>Doğrulanmış Müşteri
                                    </span>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
        <div class="row align-items-center">
            <div class="col-md-12 text-center">
                <div class="text-bg" data-aos="fade-up" data-aos-duration="1000">
                    <h2 style="color:rgba(255,255,255,0.06); font-weight:800; letter-spacing:2px;">Geri Bildirim</h2>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- testimonial-area-end -->