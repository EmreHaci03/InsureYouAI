@model ProfileViewModel
<li class="nav-item dropdown dropdown-user-setting">
    <a class="nav-link dropdown-toggle dropdown-toggle-nocaret" href="#" data-bs-toggle="dropdown">
        <div class="user-setting d-flex align-items-center">
            @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl" class="user-img" alt="">
            }
            else
            {
                <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold text-white user-img"
                     style="width:38px; height:38px; background:linear-gradient(135deg,#6366f1,#8b5cf6); font-size:14px;">
                    @(!string.IsNullOrEmpty(Model.Name) ? Model.Name.Substring(0, 1) : "?")@(!string.IsNullOrEmpty(Model.Surname) ? Model.Surname.Substring(0, 1) : "")
                </div>
            }
        </div>
    </a>
    <ul class="dropdown-menu dropdown-menu-end">
        <li>
            <a class="dropdown-item" href="#">
                <div class="d-flex align-items-center">
                    @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                    {
                        <img src="@Model.ImageUrl" alt="" class="rounded-circle" width="54" height="54">
                    }
                    else
                    {
                        <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold text-white"
                             style="width:54px; height:54px; background:linear-gradient(135deg,#6366f1,#8b5cf6); font-size:18px;">
                            @(!string.IsNullOrEmpty(Model.Name) ? Model.Name.Substring(0, 1) : "?")@(!string.IsNullOrEmpty(Model.Surname) ? Model.Surname.Substring(0, 1) : "")
                        </div>
                    }
                    <div class="ms-3">
                        <h6 class="mb-0 dropdown-user-name">@Model.Name @Model.Surname</h6>
                        <small class="mb-0 dropdown-user-designation text-secondary">@Model.Description</small>
                    </div>
                </div>
            </a>
        </li>
        <li><hr class="dropdown-divider"></li>
        <li>
            <a class="dropdown-item" href="/AppUser/UserProfile/@Model.Id/">
                <div class="d-flex align-items-center">
                    <div class=""><i class="bi bi-person-fill"></i></div>
                    <div class="ms-3"><span>Profilim</span></div>
                </div>
            </a>
        </li>
        <li>
            <a class="dropdown-item" href="/Article/ArticleList/">
                <div class="d-flex align-items-center">
                    <div class=""><i class="bi bi-newspaper"></i></div>
                    <div class="ms-3"><span>Makalelerim</span></div>
                </div>
            </a>
        </li>
        <li>
            <a class="dropdown-item" href="/Comment/CommentList/">
                <div class="d-flex align-items-center">
                    <div class=""><i class="bi bi-chat-square-text-fill"></i></div>
                    <div class="ms-3"><span>Onay Bekleyen Yorumlar</span></div>
                </div>
            </a>
        </li>
        <li>
            <a class="dropdown-item" href="/Message/MessageList/">
                <div class="d-flex align-items-center">
                    <div class=""><i class="bi bi-envelope-fill"></i></div>
                    <div class="ms-3"><span>Mesaj Kutum</span></div>
                </div>
            </a>
        </li>
        <li><hr class="dropdown-divider"></li>
        <li>
            <a class="dropdown-item" href="/Account/LogOut/">
                <div class="d-flex align-items-center">
                    <div class=""><i class="bi bi-lock-fill"></i></div>
                    <div class="ms-3"><span>Çıkış Yap</span></div>
                </div>
            </a>
        </li>
    </ul>
</li>