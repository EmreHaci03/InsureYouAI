@model GetArticleByIdDto
<div class="col-xl-4 col-md-5">
    @if (Model != null)
    {
        <div class="next-link" style="display:flex; align-items:center; justify-content:flex-end; gap:16px; background:#fff; border-radius:14px; padding:18px 20px; box-shadow:0 5px 20px rgba(0,0,0,0.06); transition:transform .25s ease;"
             onmouseover="this.style.transform='translateY(-4px)';" onmouseout="this.style.transform='translateY(0)';">
            <div style="min-width:0; text-align:right;">
                <span style="display:flex; align-items:center; justify-content:flex-end; gap:6px; color:#8891ac; font-size:13px; font-weight:600; text-transform:uppercase; letter-spacing:.3px; margin-bottom:8px;">
                    Sonraki Post <i class="fal fa-arrow-right" style="color:#ff5e14;"></i>
                </span>
                <h4 style="margin:0; font-size:16.5px; line-height:1.45; font-weight:700;">
                    <a href="/Blog/BlogDetail/@Model.ArticleId" style="color:#28314b; font-weight:700; text-decoration:none; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden;">
                        @Model.Title
                    </a>
                </h4>
            </div>
            <div style="width:80px; height:80px; border-radius:12px; overflow:hidden; flex-shrink:0;">
                <img src="@Model.CoverImageUrl" alt="@Model.Title" style="width:100%; height:100%; object-fit:cover;">
            </div>
        </div>
    }
</div>