<div class="col-12 col-lg-8 col-xl-8 d-flex">
    <div class="card w-100 rounded-4">
        <div class="card-body">
            <div class="d-flex align-items-center mb-3">
                <h6 class="mb-0">Bu Ayki Gider Dağılımı</h6>
                <div class="fs-5 ms-auto dropdown">
                    <div class="dropdown-toggle dropdown-toggle-nocaret cursor-pointer" data-bs-toggle="dropdown"><i class="bi bi-three-dots"></i></div>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item" href="#">Action</a></li>
                        <li><a class="dropdown-item" href="#">Another action</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item" href="#">Something else here</a></li>
                    </ul>
                </div>
            </div>
            <div class="d-flex align-items-center gap-3 mb-3">
                <div class="">
                    <h4 class="text-danger mb-0">₺@ViewBag.TotalExpense.ToString("N2")</h4>
                    <p class="mb-0">Toplam Gider</p>
                </div>
            </div>

            @if (ViewBag.ExpenseLabel != "[]")
            {
                <ul class="list-group list-group-flush mb-0 shadow-none">
                    @{
                        var labels = System.Text.Json.JsonSerializer.Deserialize<List<string>>(ViewBag.ExpenseLabel);
                        var values = System.Text.Json.JsonSerializer.Deserialize<List<decimal>>(ViewBag.ExpenseValues);
                        int i = 0;
                    }
                    @for (int idx = 0; idx < labels.Count; idx++)
                    {
                        <li class="list-group-item bg-transparent @(idx == 0 ? "border-top" : "") d-flex justify-content-between align-items-center">
                            <span class="small">@labels[idx]</span>
                            <span class="fw-semibold text-danger">₺@values[idx].ToString("N2")</span>
                        </li>
                        i++;
                    }
                </ul>
            }
            else
            {
                <div class="text-center py-4">
                    <i class="bi bi-wallet2" style="font-size:28px; color:#c3c2b7;"></i>
                    <p class="text-muted small mb-0 mt-2">Bu ay için gider kaydı bulunmuyor</p>
                </div>
            }
        </div>
    </div>
</div>