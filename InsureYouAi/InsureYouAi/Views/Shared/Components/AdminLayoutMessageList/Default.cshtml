@model List<ResultMessageDto>
<li class="nav-item dropdown dropdown-large">
    <a class="nav-link dropdown-toggle dropdown-toggle-nocaret" href="#" data-bs-toggle="dropdown">
        <div class="messages">
            <span class="notify-badge">@ViewBag.Count</span>
            <i class="bi bi-chat-right-fill"></i>
        </div>
    </a>
    <div class="dropdown-menu dropdown-menu-end p-0">
        <div class="p-2 border-bottom m-2">
            <h5 class="h5 mb-0">Mesajlar</h5>
        </div>
        <div class="header-message-list p-2">
            @if (Model != null && Model.Any())
            {
                @foreach (var item in Model)
                {
                    var initial = string.IsNullOrWhiteSpace(item.NameSurname) ? "?" : item.NameSurname.Trim()[0].ToString().ToUpper();
                    var preview = item.MessageDetail?.Length > 40 ? item.MessageDetail.Substring(0, 40) + "..." : item.MessageDetail;

                    <a class="dropdown-item" href="/Message/GetMessage/@item.MessageId">
                        <div class="d-flex align-items-center">
                            <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold text-white flex-shrink-0"
                                 style="width:44px; height:44px; background:linear-gradient(135deg,#6366f1,#8b5cf6); font-size:15px;">
                                @initial
                            </div>
                            <div class="ms-3 flex-grow-1" style="min-width:0;">
                                <h6 class="mb-0 dropdown-msg-user text-truncate">
                                    @item.NameSurname
                                    <span class="msg-time float-end text-secondary" style="font-size:11px;">@item.SendDate.ToString("dd MMM")</span>
                                </h6>
                                <small class="mb-0 dropdown-msg-text text-secondary d-flex align-items-center text-truncate">@preview</small>
                            </div>
                        </div>
                    </a>
                }
            }
            else
            {
                <div class="text-center text-muted small py-3">
                    <i class="bi bi-envelope-open" style="font-size:22px; display:block; margin-bottom:8px; opacity:.5;"></i>
                    Okunmamış mesajınız yok
                </div>
            }
        </div>
        <div class="p-2">
            <div><hr class="dropdown-divider"></div>
            <a class="dropdown-item" href="/Message/MessageList/">
                <div class="text-center">Tüm Mesajları Gör</div>
            </a>
        </div>
    </div>
