@model List<ResultArticleDto>
<div class="col-xl-3 col-lg-3 col-sm-6">
    <div class="footer-widget mb-30" data-aos="fade-up" data-aos-duration="1800">
        <div class="f-widget-title">
            <h2>Son Yazılar</h2>
        </div>
        <div class="recent-blog-footer">
            <ul>
                @foreach (var item in Model.OrderByDescending(x => x.CreatedDate).Take(2))
                {
                    <li>
                        <div class="thum">
                            <img src="@item.CoverImageUrl" alt="@item.Title">
                        </div>
                        <div class="text">
                            <a href="/Default/Article/@item.ArticleId">@item.Title</a>
                            <span>@item.CreatedDate.ToString("dd MMMM yyyy")</span>
                        </div>
                    </li>
                }
            </ul>
        </div>
    </div>
</div>