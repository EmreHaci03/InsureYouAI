@model List<ResultTrailerVideoDto>
<section id="video" class="video-area p-relative" data-aos="fade-up" data-aos-duration="1000" style="padding:0 0 100px;">
    <div class="container">
        @foreach (var item in Model)
        {
            <div class="row">
                <div class="col-12">
                    <div class="s-video-wrap video-card" style="
                            background-image: linear-gradient(135deg, rgba(20,25,45,0.65), rgba(255,94,20,0.25)), url('@item.CoverImageUrl');
                            background-size: cover;
                            background-position: center;
                            background-repeat: no-repeat;
                            border-radius: 24px;
                            overflow: hidden;
                            position: relative;
                            height: 480px;
                            display: flex;
                            align-items: center;
                            justify-content: center;
                            margin-bottom: 24px;
                            box-shadow: 0 25px 50px rgba(0,0,0,0.2);
                            ">

                        <div style="position:absolute; top:-60px; right:-60px; width:200px; height:200px; border-radius:50%; background:rgba(255,255,255,0.06); filter:blur(10px);"></div>

                        <div class="s-video-content text-center" style="position:relative; z-index:2;">
                            <span style="display:inline-flex; align-items:center; gap:8px; background:rgba(255,255,255,0.15); backdrop-filter:blur(6px); color:#fff; padding:6px 16px; border-radius:30px; font-size:12.5px; font-weight:600; letter-spacing:.5px; margin-bottom:20px; border:1px solid rgba(255,255,255,0.25);">
                                <i class="fal fa-play-circle"></i> Tanıtım Videosu
                            </span>
                            <h2 style="color:#fff; font-size:32px; font-weight:700; margin-bottom:28px; text-shadow:0 2px 20px rgba(0,0,0,0.3); max-width:600px; margin-left:auto; margin-right:auto;">@item.Title</h2>

                            <a href="@item.VideoUrl" class="popup-video video-play-btn" style="
                                    display:inline-flex;
                                    align-items:center;
                                    justify-content:center;
                                    width:90px;
                                    height:90px;
                                    border-radius:50%;
                                    background:rgba(255,255,255,0.15);
                                    backdrop-filter:blur(6px);
                                    border:2px solid rgba(255,255,255,0.4);
                                    transition:transform .3s ease, background .3s ease;
                                    margin-bottom:18px;
                                    ">
                                <i class="fal fa-play" style="color:#fff; font-size:28px; margin-left:4px;"></i>
                            </a>

                            <p style="color:rgba(255,255,255,0.85); font-size:14px; font-weight:600; letter-spacing:.5px; margin:0;">
                                İzlemek İçin Tıklayın
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

<style>
    .video-play-btn:hover {
        transform: scale(1.1);
        background: #ff5e14 !important;
        border-color: #ff5e14 !important;
    }

    .video-card {
        transition: transform .4s ease;
    }
</style>