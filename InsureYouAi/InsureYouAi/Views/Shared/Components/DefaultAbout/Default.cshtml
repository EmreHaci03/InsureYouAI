@model List<ResultAboutDto>
<section class="about-area about-p pt-120 pb-120 p-relative fix" style="background:#f9fafc;">
    <div class="container">
        @foreach (var item in Model)
        {
            <div class="row justify-content-center align-items-center mb-5">
                <div class="col-lg-6 col-md-12 col-sm-12">
                    <div class="s-about-img p-relative" data-aos="fade-up" data-aos-duration="1000" style="border-radius:20px; overflow:hidden; box-shadow:0 15px 40px rgba(0,0,0,0.1);">
                        <img src="@item.ImageUrl" alt="@item.Title" style="width:100%; height:420px; object-fit:cover; display:block;">
                    </div>
                </div>
                <div class="col-lg-6 col-md-12 col-sm-12">
                    <div class="about-content s-about-content" style="padding-left:20px;">
                        <span style="display:inline-flex; align-items:center; gap:8px; background:rgba(255,94,20,0.1); color:#ff5e14; padding:6px 16px; border-radius:30px; font-size:12.5px; font-weight:600; letter-spacing:.5px; margin-bottom:16px;">
                            <i class="fal fa-shield-check"></i> Hakkımızda
                        </span>
                        <div class="about-title second-title pb-25">
                            <h2 data-aos="fade-up" data-aos-duration="1000" style="font-size:32px; font-weight:700; color:#28314b; line-height:1.35;">@item.Title</h2>
                        </div>
                        <p data-aos="fade-up" data-aos-duration="1000" style="color:#6b7280; font-size:15px; line-height:1.9;">@item.Description</p>
                        <div class="about-content3 mt-30" data-aos="fade-up" data-aos-duration="1200">
                            <div class="row">
                                <div class="col-md-12">
                                    @await Component.InvokeAsync("DefaultAboutItem", new { id = item.AboutId })
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</section>