@model List<ResultArticleDto>
<section id="recent-posts-4" class="widget widget_recent_entries" style="background:#fff; border-radius:14px; padding:30px; box-shadow:0 5px 25px rgba(0,0,0,0.06);">
    <h2 class="widget-title" style="font-size:20px; font-weight:700; color:#28314b; margin-bottom:24px; padding-bottom:14px; border-bottom:2px solid #f4f5f9; position:relative;">
        Son Eklenen Postlar
        <span style="position:absolute; bottom:-2px; left:0; width:45px; height:2px; background:#ff5e14;"></span>
    </h2>
    <ul style="list-style:none; padding:0; margin:0;">
        @foreach (var item in Model.Take(3))
        {
            <li style="display:flex; align-items:center; gap:15px; margin-bottom:20px; padding-bottom:20px; border-bottom:1px solid #f4f5f9;">
                <div style="flex-shrink:0; width:70px; height:70px; border-radius:10px; overflow:hidden;">
                    <img src="@item.CoverImageUrl" alt="@item.Title" style="width:100%; height:100%; object-fit:cover; transition:transform .3s ease;"
                         onmouseover="this.style.transform='scale(1.1)';" onmouseout="this.style.transform='scale(1)';">
                </div>
                <div style="flex:1; min-width:0;">
                    <a href="/Blog/BlogDetail/@item.ArticleId/" style="display:block; color:#28314b; font-weight:600; font-size:14.5px; line-height:1.5; text-decoration:none; margin-bottom:6px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; transition:color .2s;"
                       onmouseover="this.style.color='#ff5e14';" onmouseout="this.style.color='#28314b';">
                        @item.Title
                    </a>
                    <span class="post-date" style="display:flex; align-items:center; gap:6px; color:#8891ac; font-size:12.5px;">
                        <i class="fal fa-calendar-alt"></i> @item.CreatedDate.ToString("dd MMM yyyy")
                    </span>
                </div>
            </li>
        }
    </ul>
</section>