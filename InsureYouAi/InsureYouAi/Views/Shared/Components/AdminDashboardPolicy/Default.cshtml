@using InsureYouAi.Models
<div class="col-12 col-lg-4 col-xl-4 d-flex">
    <div class="card w-100 rounded-4">
        <div class="card-body">
            <div class="d-flex align-items-center mb-3">
                <h6 class="mb-0">Bu Ayki Poliçe Dağılımı</h6>
                <div class="fs-5 ms-auto dropdown">
                    <div class="dropdown-toggle dropdown-toggle-nocaret cursor-pointer" data-bs-toggle="dropdown"><i class="bi bi-three-dots"></i></div>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item" href="#">Tüm Poliçeler</a></li>
                    </ul>
                </div>
            </div>

            @{
                var labels = System.Text.Json.JsonSerializer.Deserialize<List<string>>(ViewBag.Detail);
                var hasData = labels != null && labels.Count > 0;
            }

            @if (hasData)
            {
                <div style="position:relative; width:100%; height:220px;">
                    <canvas id="policyDonutChart"></canvas>
                </div>
            }
            else
            {
                <div class="text-center py-4">
                    <i class="bi bi-pie-chart" style="font-size:28px; color:#c3c2b7;"></i>
                    <p class="text-muted small mb-0 mt-2">Bu ay için poliçe kaydı bulunmuyor</p>
                </div>
            }
        </div>
    </div>
</div>

@if (hasData)
{
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.js"></script>
    <script>
        (function () {
            var labels = @Html.Raw(ViewBag.Detail);
            var data = @Html.Raw(ViewBag.Sum);

            var ctx = document.getElementById('policyDonutChart');
            if (!ctx) return;

            new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: labels,
                    datasets: [{
                        data: data,
                        backgroundColor: ['#6366f1', '#22c55e', '#f59e0b', '#ef4444', '#06b6d4'],
                        borderWidth: 2,
                        borderColor: '#fff'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: '60%',
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: { boxWidth: 12, font: { size: 11 } }
                        },
                        tooltip: {
                            callbacks: {
                                label: function (context) {
                                    return context.label + ': ₺' + context.parsed.toLocaleString('tr-TR');
                                }
                            }
                        }
                    }
                }
            });
        })();
    </script>
}