@model List<ResultSliderDto>
@{
    Layout = "/Views/Shared/_AdminLayout.cshtml";
    string[] gradients = new[]
    {
        "linear-gradient(135deg,#6366f1,#8b5cf6)",
        "linear-gradient(135deg,#06b6d4,#3b82f6)",
        "linear-gradient(135deg,#f59e0b,#ef4444)",
        "linear-gradient(135deg,#10b981,#059669)",
        "linear-gradient(135deg,#ec4899,#f43f5e)",
    };
}
@section BreadCrumb {
    <div class="page-breadcrumb d-none d-sm-flex align-items-center mb-3">
        <div class="breadcrumb-title pe-3"><i class="bi bi-images me-1"></i>Slider</div>
        <div class="ps-3">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 p-0">
                    <li class="breadcrumb-item">
                        <a href="javascript:;"><i class="bx bx-home-alt"></i></a>
                    </li>
                    <li class="breadcrumb-item">
                        <a asp-action="SliderList">Slider</a>
                    </li>
                    <li class="breadcrumb-item active" aria-current="page">Liste</li>
                </ol>
            </nav>
        </div>
    </div>
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-3 border-0 shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="d-flex flex-wrap align-items-center justify-content-between mb-4 gap-3">
    <div>
        <h4 class="fw-bold mb-1">Slider <span class="badge rounded-pill bg-light text-dark ms-1">@(Model?.Count ?? 0)</span></h4>
        <p class="text-muted mb-0 small">Ana sayfa slider görsellerini yönetin</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <div class="position-relative">
            <i class="bi bi-search position-absolute top-50 translate-middle-y ms-3 text-muted"></i>
            <input class="form-control ps-5 rounded-pill border-0 shadow-sm" type="text" placeholder="Slider ara..." id="searchInput" style="min-width:240px;">
        </div>
        <a asp-action="CreateSlider" class="btn btn-primary rounded-pill px-4 shadow-sm">
            <i class="bi bi-plus-lg me-1"></i>Yeni Slider
        </a>
    </div>
</div>

@if (Model != null && Model.Any())
{
    <div class="row g-3" id="sliderGrid">
        @for (int i = 0; i < Model.Count; i++)
        {
            var item = Model[i];
            var gradient = gradients[i % gradients.Length];
            var safeTitle = item.Title ?? "";
            var preview = item.Description?.Length > 90 ? item.Description.Substring(0, 90) + "…" : item.Description;

            <div class="col-xl-4 col-lg-6 slider-card-wrap" data-name="@safeTitle.ToLower()">
                <div class="card border-0 shadow-sm h-100 slider-card overflow-hidden">
                    <div class="position-relative" style="overflow:hidden;">
                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                        {
                            <img src="@item.ImageUrl" class="w-100 slider-thumb" style="height:170px; object-fit:cover; transition:transform .5s ease;" alt="@safeTitle" />
                        }
                        else
                        {
                            <div class="w-100 d-flex align-items-center justify-content-center" style="height:170px; background:@gradient;">
                                <i class="bi bi-image text-white fs-1 opacity-75"></i>
                            </div>
                        }

                        <div class="dropdown position-absolute top-0 end-0 mt-2 me-2">
                            <button class="btn btn-sm btn-icon border-0 bg-white shadow-sm rounded-circle" type="button" data-bs-toggle="dropdown">
                                <i class="bi bi-three-dots-vertical"></i>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0">
                                <li>
                                    <a class="dropdown-item" asp-action="UpdateSlider" asp-route-id="@item.SliderId">
                                        <i class="bi bi-pencil-fill me-2 text-warning"></i>Düzenle
                                    </a>
                                </li>
                                <li>
                                    <button type="button" class="dropdown-item text-danger btn-delete-slider"
                                            data-id="@item.SliderId" data-name="@safeTitle" data-image="@item.ImageUrl" data-gradient="@gradient">
                                        <i class="bi bi-trash-fill me-2"></i>Sil
                                    </button>
                                </li>
                            </ul>
                        </div>
                    </div>

                    <div class="card-body pt-3 d-flex flex-column">
                        <h6 class="fw-semibold mb-2">@item.Title</h6>
                        <p class="text-muted small mb-3 flex-grow-1" style="min-height:55px;">
                            @preview
                        </p>
                        <div class="d-flex gap-2">
                            <a asp-action="UpdateSlider" asp-route-id="@item.SliderId" class="text-decoration-none small fw-semibold flex-grow-1" style="color:#6366f1;">
                                Düzenle <i class="bi bi-arrow-right ms-1"></i>
                            </a>
                            <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-3 btn-delete-slider"
                                    data-id="@item.SliderId" data-name="@safeTitle" data-image="@item.ImageUrl" data-gradient="@gradient">
                                <i class="bi bi-trash-fill"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="card border-0 shadow-sm">
        <div class="card-body text-center py-5">
            <div class="rounded-circle bg-light d-inline-flex align-items-center justify-content-center mb-3" style="width:72px; height:72px;">
                <i class="bi bi-inbox fs-2 text-muted"></i>
            </div>
            <h6 class="fw-semibold">Henüz slider eklenmemiş</h6>
            <p class="text-muted small">Başlamak için ilk slider görselinizi oluşturun</p>
            <a asp-action="CreateSlider" class="btn btn-primary rounded-pill px-4 mt-2">
                <i class="bi bi-plus-lg me-1"></i>İlk Slider'ı Ekle
            </a>
        </div>
    </div>
}

<form id="deleteForm" asp-action="DeleteSlider" method="post" class="d-none">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" id="deleteSliderId" value="" />
</form>

<!-- Silme Onay Modalı -->
<div class="modal fade" id="deleteConfirmModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius:20px; overflow:hidden;">
            <div class="modal-body p-0">
                <div class="text-center pt-4 pb-2 px-4">
                    <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-3"
                         style="width:72px; height:72px; background:#fdeaea;">
                        <i class="bi bi-trash3-fill text-danger" style="font-size:28px;"></i>
                    </div>
                    <h5 class="fw-bold mb-1">Slider'ı Sil</h5>
                    <p class="text-muted small mb-3">Bu işlem geri alınamaz. Devam etmek istediğinize emin misiniz?</p>
                </div>

                <div class="mx-4 mb-4 rounded-3 bg-light overflow-hidden d-flex align-items-center gap-3" style="border-left:3px solid #dc3545;">
                    <div id="deleteSliderThumbWrap" style="width:64px; height:64px; flex-shrink:0; overflow:hidden;">
                        <img id="deleteSliderThumb" src="" style="width:100%; height:100%; object-fit:cover; display:none;" />
                        <div id="deleteSliderThumbFallback" class="w-100 h-100 d-flex align-items-center justify-content-center">
                            <i class="bi bi-image text-white fs-4 opacity-75"></i>
                        </div>
                    </div>
                    <div class="min-w-0 text-start py-2 pe-3">
                        <h6 id="deleteSliderName" class="fw-semibold mb-0 small text-truncate"></h6>
                    </div>
                </div>

                <div class="d-flex gap-2 px-4 pb-4">
                    <button type="button" class="btn btn-light flex-grow-1 rounded-pill fw-semibold" data-bs-dismiss="modal">
                        Vazgeç
                    </button>
                    <button type="button" id="confirmDeleteSliderBtn" class="btn btn-danger flex-grow-1 rounded-pill fw-semibold shadow-sm">
                        <i class="bi bi-trash3-fill me-1"></i>Evet, Sil
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .slider-card {
        transition: all 0.25s ease;
        border-radius: 16px;
    }

        .slider-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 24px rgba(0,0,0,0.08) !important;
        }

            .slider-card:hover .slider-thumb {
                transform: scale(1.08);
            }

    .min-w-0 {
        min-width: 0;
    }

    #deleteConfirmModal .modal-content {
        animation: modalPopSlider .25s ease;
    }

    @@keyframes modalPopSlider {
        from {
            opacity: 0;
            transform: scale(.92);
        }

        to {
            opacity: 1;
            transform: scale(1);
        }
    }

    #confirmDeleteSliderBtn:hover {
        background: #b02a37;
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function () {

        var searchInput = document.getElementById('searchInput');
        if (searchInput) {
            searchInput.addEventListener('input', function () {
                var term = this.value.toLowerCase();
                document.querySelectorAll('.slider-card-wrap').forEach(function (card) {
                    card.style.display = card.dataset.name.includes(term) ? '' : 'none';
                });
            });
        }

        var deleteModalEl = document.getElementById('deleteConfirmModal');
        var deleteModal = new bootstrap.Modal(deleteModalEl);
        var pendingDeleteId = null;

        document.querySelectorAll('.btn-delete-slider').forEach(function (btn) {
            btn.addEventListener('click', function () {
                pendingDeleteId = this.dataset.id;

                document.getElementById('deleteSliderName').textContent = this.dataset.name;

                var img = document.getElementById('deleteSliderThumb');
                var fallback = document.getElementById('deleteSliderThumbFallback');
                var imageUrl = this.dataset.image;

                if (imageUrl) {
                    img.src = imageUrl;
                    img.style.display = 'block';
                    fallback.style.display = 'none';
                } else {
                    img.style.display = 'none';
                    fallback.style.display = 'flex';
                    fallback.style.background = this.dataset.gradient;
                }

                deleteModal.show();
            });
        });

        document.getElementById('confirmDeleteSliderBtn').addEventListener('click', function () {
            if (!pendingDeleteId) return;

            var btn = this;
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Siliniyor...';

            document.getElementById('deleteSliderId').value = pendingDeleteId;
            document.getElementById('deleteForm').submit();
        });

    });
</script>
