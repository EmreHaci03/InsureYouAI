@model List<ResultNewsletterDto>
@{
    Layout = "/Views/Shared/_AdminLayout.cshtml";
    int count = 0;
}
@section BreadCrumb {
    <div class="page-breadcrumb d-none d-sm-flex align-items-center mb-3">
        <div class="breadcrumb-title pe-3"><i class="bi bi-send-fill me-1"></i>Bülten Aboneleri</div>
        <div class="ps-3">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 p-0">
                    <li class="breadcrumb-item">
                        <a href="javascript:;"><i class="bx bx-home-alt"></i></a>
                    </li>
                    <li class="breadcrumb-item">
                        <a asp-action="NewsletterList">Bülten Aboneleri</a>
                    </li>
                    <li class="breadcrumb-item active" aria-current="page">Liste</li>
                </ol>
            </nav>
        </div>
    </div>
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-3 border-0 shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card border-0 shadow-sm">
    <div class="card-header bg-white border-0 pt-4 pb-0">
        <div class="d-flex flex-wrap align-items-center gap-2">
            <div>
                <h5 class="mb-0 fw-bold">Bülten Aboneleri <span class="badge rounded-pill bg-light text-dark ms-1">@(Model?.Count ?? 0)</span></h5>
                <p class="text-muted small mb-0">E-posta bültenine kayıtlı kullanıcılar</p>
            </div>
            <div class="ms-auto">
                <div class="position-relative">
                    <i class="bi bi-search position-absolute top-50 translate-middle-y ms-3 text-muted"></i>
                    <input class="form-control ps-5 rounded-pill border-0 shadow-sm" type="text" placeholder="E-posta ara..." id="searchInput" style="min-width:240px;">
                </div>
            </div>
        </div>
    </div>

    <div class="card-body pt-3">
        <div class="table-responsive">
            <table class="table align-middle table-hover mb-0" id="newsletterTable">
                <thead>
                    <tr class="text-muted small text-uppercase border-bottom">
                        <th class="fw-semibold" style="width: 60px;">#</th>
                        <th class="fw-semibold">E-posta</th>
                        <th class="fw-semibold text-end" style="width: 90px;">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            count++;
                            var safeEmail = item.Email ?? "";

                            <tr class="newsletter-row" data-email="@safeEmail.ToLower()">
                                <td class="text-muted">@count</td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                                             style="width:36px; height:36px; background:linear-gradient(135deg,#6366f1,#8b5cf6);">
                                            <i class="bi bi-envelope-fill text-white" style="font-size:14px;"></i>
                                        </div>
                                        <span>@safeEmail</span>
                                    </div>
                                </td>
                                <td class="text-end">
                                    <button type="button" class="btn btn-sm btn-icon btn-light-danger rounded-circle btn-delete-newsletter"
                                            data-id="@item.NewsletterId" data-name="@safeEmail" title="Sil">
                                        <i class="bi bi-trash-fill"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="3" class="text-center py-5">
                                <i class="bi bi-inbox fs-1 d-block mb-2 text-muted opacity-50"></i>
                                <p class="text-muted mb-0">Henüz abone bulunmuyor.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<form id="deleteForm" asp-action="DeleteNewsletter" method="post" class="d-none">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" id="deleteNewsletterId" value="" />
</form>

<script>
    document.addEventListener('DOMContentLoaded', function () {

        var searchInput = document.getElementById('searchInput');
        if (searchInput) {
            searchInput.addEventListener('input', function () {
                var term = this.value.toLowerCase();
                document.querySelectorAll('.newsletter-row').forEach(function (row) {
                    row.style.display = row.dataset.email.includes(term) ? '' : 'none';
                });
            });
        }

        document.querySelectorAll('.btn-delete-newsletter').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var id = this.dataset.id;
                var name = this.dataset.name;

                if (confirm('"' + name + '" adresini abonelikten çıkarmak istediğinize emin misiniz?')) {
                    document.getElementById('deleteNewsletterId').value = id;
                    document.getElementById('deleteForm').submit();
                }
            });
        });

    });
</script>