@using InsureYouAi.Entities.Enums
@model List<ResultCommentDto>
@{
    Layout = "/Views/Shared/_AdminLayout.cshtml";
    string[] gradients = new[]
    {
        "linear-gradient(135deg,#6366f1,#8b5cf6)",
        "linear-gradient(135deg,#06b6d4,#3b82f6)",
        "linear-gradient(135deg,#f59e0b,#ef4444)",
        "linear-gradient(135deg,#10b981,#059669)",
        "linear-gradient(135deg,#ec4899,#f43f5e)",
        "linear-gradient(135deg,#8b5cf6,#6366f1)"
    };
}
@section BreadCrumb {
    <div class="page-breadcrumb d-none d-sm-flex align-items-center mb-3">
        <div class="breadcrumb-title pe-3"><i class="bi bi-chat-square-text-fill me-1"></i>Yorumlar</div>
        <div class="ps-3">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 p-0">
                    <li class="breadcrumb-item">
                        <a href="javascript:;"><i class="bx bx-home-alt"></i></a>
                    </li>
                    <li class="breadcrumb-item">
                        <a asp-action="CommentList">Yorumlar</a>
                    </li>
                    <li class="breadcrumb-item active" aria-current="page">Yorum Listesi</li>
                </ol>
            </nav>
        </div>
    </div>
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-3 border-0 shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-warning alert-dismissible fade show rounded-3 border-0 shadow-sm" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="d-flex flex-wrap align-items-center justify-content-between mb-4 gap-3">
    <div>
        <h4 class="fw-bold mb-1">Yorumlar <span class="badge rounded-pill bg-light text-dark ms-1">@(Model?.Count ?? 0)</span></h4>
        <p class="text-muted mb-0 small">Kullanıcıların makalelerinize bıraktığı yorumları yönetin</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <div class="position-relative">
            <i class="bi bi-search position-absolute top-50 translate-middle-y ms-3 text-muted"></i>
            <input class="form-control ps-5 rounded-pill border-0 shadow-sm" type="text" placeholder="Yorum, kullanıcı veya makale ara..." id="searchInput" style="min-width:280px;">
        </div>
    </div>
</div>

@if (Model != null && Model.Any())
{
    <div class="row g-3" id="commentGrid">
        @for (int i = 0; i < Model.Count; i++)
        {
            var item = Model[i];
            var gradient = gradients[i % gradients.Length];
            var safeUser = item.AppUser ?? "Anonim";
            var initial = string.IsNullOrWhiteSpace(safeUser) ? "?" : safeUser.Trim()[0].ToString().ToUpper();
            var searchBlob = $"{item.AppUser} {item.Article} {item.CommentDetail}".ToLower();
            var preview = (item.CommentDetail ?? "").Length > 140 ? item.CommentDetail.Substring(0, 140) + "…" : item.CommentDetail;
            var statusText = item.CommentStatusType switch
            {
                var s when s == CommentStatusType.Approved.ToString() => "Onaylandı",
                var s when s == CommentStatusType.Pending.ToString() => "Bekliyor",
                var s when s == CommentStatusType.Rejected.ToString() => "Reddedildi",
                _ => "Bilinmiyor"
            };
            var statusColor = item.CommentStatusType switch
            {
                var s when s == CommentStatusType.Approved.ToString() => "#28a745",
                var s when s == CommentStatusType.Pending.ToString() => "#f59e0b",
                var s when s == CommentStatusType.Rejected.ToString() => "#dc3545",
                _ => "#8891ac"
            };
            var statusBg = item.CommentStatusType switch
            {
                var s when s == CommentStatusType.Approved.ToString() => "#eafaf1",
                var s when s == CommentStatusType.Pending.ToString() => "#fff8ec",
                var s when s == CommentStatusType.Rejected.ToString() => "#fdeaea",
                _ => "#f4f5f9"
            };
            var statusIcon = item.CommentStatusType switch
            {
                var s when s == CommentStatusType.Approved.ToString() => "bi-check-circle-fill",
                var s when s == CommentStatusType.Pending.ToString() => "bi-hourglass-split",
                var s when s == CommentStatusType.Rejected.ToString() => "bi-x-circle-fill",
                _ => "bi-question-circle-fill"
            };

            <div class="col-xl-4 col-lg-6 col-md-6 comment-card-wrap" data-search="@searchBlob">
                <div class="card border-0 shadow-sm h-100 comment-card position-relative overflow-hidden">
                    <div class="position-absolute top-0 end-0 opacity-25" style="width:90px; height:90px; background:@gradient; border-radius:0 0 0 100%;"></div>

                    <div class="card-body position-relative d-flex flex-column">
                        <div class="dropdown position-absolute top-0 end-0 mt-2 me-2">
                            <button class="btn btn-sm btn-icon border-0 text-muted" type="button" data-bs-toggle="dropdown">
                                <i class="bi bi-three-dots-vertical"></i>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0">
                                <li>
                                    <a class="dropdown-item" asp-action="CommentDetail" asp-route-id="@item.CommentId">
                                        <i class="bi bi-eye-fill me-2 text-primary"></i>Görüntüle
                                    </a>
                                </li>
                                <li>
                                    <button type="button" class="dropdown-item text-danger btn-delete-comment"
                                            data-id="@item.CommentId" data-name="@safeUser" data-preview="@preview" data-gradient="@gradient" data-initial="@initial">
                                        <i class="bi bi-trash-fill me-2"></i>Sil
                                    </button>
                                </li>
                            </ul>
                        </div>

                        <div class="d-flex align-items-center gap-3 mb-3">
                            <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold text-white flex-shrink-0"
                                 style="width:46px; height:46px; background:@gradient; font-size:17px;">
                                @initial
                            </div>
                            <div class="min-w-0 flex-grow-1">
                                <h6 class="fw-semibold mb-0 text-truncate" style="max-width:180px;">@safeUser</h6>
                                <p class="text-muted small mb-0">
                                    <i class="bi bi-calendar3 me-1"></i>@item.CommentDate.ToString("dd MMM yyyy, HH:mm")
                                </p>
                            </div>
                            <span class="d-inline-flex align-items-center gap-1 flex-shrink-0"
                                  style="background:@statusBg; color:@statusColor; padding:5px 12px; border-radius:20px; font-size:11.5px; font-weight:700;">
                                <i class="bi @statusIcon"></i>@statusText
                            </span>
                        </div>

                        <div class="bg-light rounded-3 p-3 mb-3 flex-grow-1" style="border-left:3px solid #6366f1;">
                            <i class="bi bi-quote text-muted"></i>
                            <p class="mb-0 small text-body" style="line-height:1.6;">@preview</p>
                        </div>

                        <div class="d-flex align-items-center small text-muted">
                            <i class="bi bi-file-earmark-text me-2" style="color:#6366f1;"></i>
                            <span class="text-truncate">@item.Article</span>
                        </div>
                    </div>

                    <div class="card-footer bg-transparent border-top-0 pt-0 d-flex gap-2">
                        <a asp-action="CommentDetail" asp-route-id="@item.CommentId" class="text-decoration-none small fw-semibold flex-grow-1" style="color:#6366f1;">
                            Detayları Gör <i class="bi bi-arrow-right ms-1"></i>
                        </a>
                        @if (item.CommentStatusType != CommentStatusType.Approved.ToString())
                        {
                            <form asp-action="ApproveComment" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@item.CommentId" />
                                <button type="submit" class="btn btn-sm btn-outline-success rounded-pill px-3">
                                    <i class="bi bi-check-circle-fill"></i>
                                </button>
                            </form>
                        }
                        <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-3 btn-delete-comment"
                                data-id="@item.CommentId" data-name="@safeUser" data-preview="@preview" data-gradient="@gradient" data-initial="@initial">
                            <i class="bi bi-trash-fill"></i>
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="card border-0 shadow-sm">
        <div class="card-body text-center py-5">
            <div class="rounded-circle bg-light d-inline-flex align-items-center justify-content-center mb-3" style="width:72px; height:72px;">
                <i class="bi bi-chat-square-text fs-2 text-muted"></i>
            </div>
            <h6 class="fw-semibold">Henüz yorum bulunmuyor</h6>
            <p class="text-muted small">Kullanıcılar makalelerinize yorum bıraktıkça burada görünecek</p>
        </div>
    </div>
}

<form id="deleteForm" asp-action="DeleteComment" method="post" class="d-none">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" id="deleteCommentId" value="" />
</form>

<!-- Silme Onay Modalı -->
<div class="modal fade" id="deleteConfirmModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius:20px; overflow:hidden;">
            <div class="modal-body p-0">
                <div class="text-center pt-4 pb-2 px-4">
                    <div id="deleteIconWrap" class="rounded-circle d-inline-flex align-items-center justify-content-center mb-3"
                         style="width:72px; height:72px; background:#fdeaea;">
                        <i class="bi bi-trash3-fill text-danger" style="font-size:28px;"></i>
                    </div>
                    <h5 class="fw-bold mb-1">Yorumu Sil</h5>
                    <p class="text-muted small mb-3">Bu işlem geri alınamaz. Devam etmek istediğinize emin misiniz?</p>
                </div>

                <div class="mx-4 mb-4 p-3 rounded-3 bg-light d-flex align-items-start gap-3" style="border-left:3px solid #dc3545;">
                    <div id="deleteUserAvatar" class="rounded-circle d-flex align-items-center justify-content-center fw-bold text-white flex-shrink-0"
                         style="width:38px; height:38px; font-size:14px;">
                        ?
                    </div>
                    <div class="min-w-0 text-start">
                        <h6 id="deleteUserName" class="fw-semibold mb-1 small"></h6>
                        <p id="deleteCommentPreview" class="text-muted small mb-0" style="line-height:1.5;"></p>
                    </div>
                </div>

                <div class="d-flex gap-2 px-4 pb-4">
                    <button type="button" class="btn btn-light flex-grow-1 rounded-pill fw-semibold" data-bs-dismiss="modal">
                        Vazgeç
                    </button>
                    <button type="button" id="confirmDeleteBtn" class="btn btn-danger flex-grow-1 rounded-pill fw-semibold shadow-sm">
                        <i class="bi bi-trash3-fill me-1"></i>Evet, Sil
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .comment-card {
        transition: all 0.25s ease;
        border-radius: 16px;
    }

        .comment-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 24px rgba(0,0,0,0.08) !important;
        }

    .min-w-0 {
        min-width: 0;
    }

    #deleteConfirmModal .modal-content {
        animation: modalPop .25s ease;
    }

    @@keyframes modalPop {
        from {
            opacity: 0;
            transform: scale(.92);
        }

        to {
            opacity: 1;
            transform: scale(1);
        }
    }

    #confirmDeleteBtn:hover {
        background: #b02a37;
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function () {

        var searchInput = document.getElementById('searchInput');
        if (searchInput) {
            searchInput.addEventListener('input', function () {
                var term = this.value.toLowerCase();
                document.querySelectorAll('.comment-card-wrap').forEach(function (card) {
                    card.style.display = card.dataset.search.includes(term) ? '' : 'none';
                });
            });
        }

        var deleteModalEl = document.getElementById('deleteConfirmModal');
        var deleteModal = new bootstrap.Modal(deleteModalEl);
        var pendingDeleteId = null;

        document.querySelectorAll('.btn-delete-comment').forEach(function (btn) {
            btn.addEventListener('click', function () {
                pendingDeleteId = this.dataset.id;

                document.getElementById('deleteUserName').textContent = this.dataset.name;
                document.getElementById('deleteCommentPreview').textContent = this.dataset.preview;

                var avatar = document.getElementById('deleteUserAvatar');
                avatar.style.background = this.dataset.gradient;
                avatar.textContent = this.dataset.initial;

                deleteModal.show();
            });
        });

        document.getElementById('confirmDeleteBtn').addEventListener('click', function () {
            if (!pendingDeleteId) return;

            var btn = this;
            var originalHtml = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Siliniyor...';

            document.getElementById('deleteCommentId').value = pendingDeleteId;
            document.getElementById('deleteForm').submit();
        });

    });
</script>
