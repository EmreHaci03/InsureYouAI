@model CreatePricingPlanDto
@{
    Layout = "/Views/Shared/_AdminLayout.cshtml";
}
@section BreadCrumb {
    <div class="page-breadcrumb d-none d-sm-flex align-items-center mb-3">
        <div class="breadcrumb-title pe-3"><i class="bi bi-cash-coin me-1"></i>Fiyat Planları</div>
        <div class="ps-3">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 p-0">
                    <li class="breadcrumb-item">
                        <a href="javascript:;"><i class="bx bx-home-alt"></i></a>
                    </li>
                    <li class="breadcrumb-item">
                        <a asp-action="PricingPlanList">Fiyat Planları</a>
                    </li>
                    <li class="breadcrumb-item active" aria-current="page">Yeni Ekle</li>
                </ol>
            </nav>
        </div>
    </div>
}

<div class="row justify-content-center">
    <div class="col-xl-6 col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">

                <div class="d-flex align-items-center gap-3 mb-4">
                    <div class="rounded-4 d-flex align-items-center justify-content-center flex-shrink-0"
                         style="width:52px; height:52px; background:linear-gradient(135deg,#6366f1,#8b5cf6);">
                        <i class="bi bi-cash-coin text-white fs-5"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold mb-0">Yeni Fiyat Planı</h5>
                        <p class="text-muted small mb-0">Yeni bir plan oluşturun</p>
                    </div>
                </div>

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <form asp-action="CreatePricingPlan" method="post">
                    <div class="mb-4">
                        <label asp-for="Title" class="form-label fw-semibold">Plan Başlığı</label>
                        <input asp-for="Title" class="form-control rounded-3" placeholder="Örn: Standart Paket" autofocus />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Price" class="form-label fw-semibold">Fiyat</label>
                        <div class="input-group">
                            <input asp-for="Price" type="number" step="0.01" class="form-control rounded-start-3" placeholder="0.00" />
                            <span class="input-group-text bg-light border-0 rounded-end-3">₺ / ay</span>
                        </div>
                        <span asp-validation-for="Price" class="text-danger small"></span>
                    </div>

                    <div class="form-check form-switch mb-4 ps-0">
                        <div class="d-flex align-items-center gap-2">
                            <input class="form-check-input ms-0" style="width:2.5em; height:1.3em;" type="checkbox" asp-for="IsFeature" role="switch" />
                            <label class="form-check-label fw-semibold" asp-for="IsFeature">
                                Öne Çıkan Plan Olarak İşaretle
                            </label>
                        </div>
                        <span class="text-muted small">Bu plan listede rozet ile vurgulanır.</span>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="PricingPlanList" class="btn btn-light rounded-pill px-4">
                            Vazgeç
                        </a>
                        <button type="submit" class="btn btn-primary rounded-pill px-4 shadow-sm">
                            <i class="bi bi-check-lg me-1"></i>Kaydet
                        </button>
                    </div>
                </form>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}