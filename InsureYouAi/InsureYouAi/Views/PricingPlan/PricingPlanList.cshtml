@model List<ResultPricingPlanDto>
@{
    Layout = "/Views/Shared/_AdminLayout.cshtml";
    int featuredCount = Model?.Count(x => x.IsFeature) ?? 0;
}
@section BreadCrumb {
    <div class="page-breadcrumb d-none d-sm-flex align-items-center mb-3">
        <div class="breadcrumb-title pe-3"><i class="bi bi-cash-coin me-1"></i>Fiyat Planları</div>
        <div class="ps-3">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 p-0">
                    <li class="breadcrumb-item">
                        <a href="javascript:;"><i class="bx bx-home-alt"></i></a>
                    </li>
                    <li class="breadcrumb-item">
                        <a asp-action="PricingPlanList">Fiyat Planları</a>
                    </li>
                    <li class="breadcrumb-item active" aria-current="page">Liste</li>
                </ol>
            </nav>
        </div>
    </div>
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-3 border-0 shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="d-flex flex-wrap align-items-center justify-content-between mb-4 gap-3">
    <div>
        <h4 class="fw-bold mb-1">
            Fiyat Planları
            <span class="badge rounded-pill bg-light text-dark ms-1">@(Model?.Count ?? 0)</span>
            @if (Model != null && Model.Any())
            {
                <span class="badge rounded-pill" style="background:#fef3e2; color:#f59e0b;">
                    <i class="bi bi-star-fill me-1"></i>@featuredCount öne çıkan
                </span>
            }
        </h4>
        <p class="text-muted mb-0 small">Sigorta paketlerinizin fiyatlandırmasını yönetin</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <div class="position-relative">
            <i class="bi bi-search position-absolute top-50 translate-middle-y ms-3 text-muted"></i>
            <input class="form-control ps-5 rounded-pill border-0 shadow-sm" type="text" placeholder="Plan ara..." id="searchInput" style="min-width:240px;">
        </div>
        <a asp-action="CreatePricingPlan" class="btn btn-primary rounded-pill px-4 shadow-sm">
            <i class="bi bi-plus-lg me-1"></i>Yeni Plan
        </a>
    </div>
</div>

@if (Model != null && Model.Any())
{
    <div class="row g-4" id="planGrid">
        @foreach (var item in Model)
        {
            var safeTitle = item.Title ?? "";
            var isFeatured = item.IsFeature;

            <div class="col-xl-3 col-lg-4 col-md-6 plan-card-wrap" data-name="@safeTitle.ToLower()">
                <div class="card border-0 h-100 plan-card position-relative @(isFeatured ? "featured-plan" : "")">

                    @if (isFeatured)
                    {
                        <div class="ribbon">
                            <i class="bi bi-star-fill me-1"></i>Öne Çıkan
                        </div>
                    }

                    <div class="card-body pt-4 pb-4 d-flex flex-column">
                        <div class="d-flex align-items-start justify-content-between mb-3">
                            <span class="badge rounded-pill d-inline-flex align-items-center gap-1"
                                  style="background:@(isFeatured ? "#fef3e2" : "#f1f2f4"); color:@(isFeatured ? "#f59e0b" : "#6b7280"); font-weight:600; font-size:11.5px; padding:5px 10px;">
                                <span class="status-dot" style="background:@(isFeatured ? "#f59e0b" : "#9ca3af");"></span>
                                @(isFeatured ? "Öne Çıkan" : "Standart")
                            </span>

                            <div class="dropdown">
                                <button class="btn btn-sm btn-icon border-0 text-muted" type="button" data-bs-toggle="dropdown">
                                    <i class="bi bi-three-dots-vertical"></i>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0">
                                    <li>
                                        <a class="dropdown-item" asp-action="UpdatePricingPlan" asp-route-id="@item.PricingPlanId">
                                            <i class="bi bi-pencil-fill me-2 text-warning"></i>Düzenle
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <button type="button" class="dropdown-item text-danger btn-delete-plan"
                                                data-id="@item.PricingPlanId" data-name="@safeTitle">
                                            <i class="bi bi-trash-fill me-2"></i>Sil
                                        </button>
                                    </li>
                                </ul>
                            </div>
                        </div>

                        <div class="text-center mb-3">
                            <div class="rounded-4 d-inline-flex align-items-center justify-content-center mb-3 plan-icon"
                                 style="background:linear-gradient(135deg,@(isFeatured ? "#f59e0b,#ef4444" : "#6366f1,#8b5cf6"));">
                                <i class="bi bi-cash-stack text-white fs-4"></i>
                            </div>
                            <h6 class="fw-semibold mb-2">@item.Title</h6>
                            <h2 class="fw-bold mb-0" style="color:@(isFeatured ? "#f59e0b" : "#6366f1");">
                                @item.Price.ToString("N0")<span class="fs-6 text-muted fw-normal">₺/ay</span>
                            </h2>
                        </div>

                        <div class="mt-auto pt-3">
                            @if (isFeatured)
                            {
                                <form asp-action="ChangePricingPlanStatusToFalse" asp-route-id="@item.PricingPlanId" method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-secondary rounded-pill w-100 fw-semibold">
                                        <i class="bi bi-star me-1"></i>Öne Çıkarmayı Kaldır
                                    </button>
                                </form>
                            }
                            else
                            {
                                <form asp-action="ChangePricingPlanStatusToTrue" asp-route-id="@item.PricingPlanId" method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm rounded-pill w-100 fw-semibold text-white" style="background:linear-gradient(135deg,#f59e0b,#ef4444); border:none;">
                                        <i class="bi bi-star-fill me-1"></i>Öne Çıkar
                                    </button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="card border-0 shadow-sm">
        <div class="card-body text-center py-5">
            <div class="rounded-circle bg-light d-inline-flex align-items-center justify-content-center mb-3" style="width:72px; height:72px;">
                <i class="bi bi-inbox fs-2 text-muted"></i>
            </div>
            <h6 class="fw-semibold">Henüz plan eklenmemiş</h6>
            <p class="text-muted small">Başlamak için ilk planınızı oluşturun</p>
            <a asp-action="CreatePricingPlan" class="btn btn-primary rounded-pill px-4 mt-2">
                <i class="bi bi-plus-lg me-1"></i>İlk Planı Ekle
            </a>
        </div>
    </div>
}

<form id="deleteForm" asp-action="DeletePricingPlan" method="post" class="d-none">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" id="deletePlanId" value="" />
</form>

<style>
    .plan-card {
        border-radius: 20px;
        box-shadow: 0 4px 16px rgba(17,24,39,0.06);
        transition: all 0.3s ease;
        overflow: hidden;
    }

        .plan-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 16px 32px rgba(17,24,39,0.1);
        }

    .featured-plan {
        border: 2px solid #f59e0b !important;
    }

    .plan-icon {
        width: 56px;
        height: 56px;
        box-shadow: 0 8px 16px rgba(99,102,241,0.25);
    }

    .status-dot {
        display: inline-block;
        width: 7px;
        height: 7px;
        border-radius: 50%;
    }

    .ribbon {
        position: absolute;
        top: 14px;
        right: -32px;
        background: linear-gradient(135deg,#f59e0b,#ef4444);
        color: #fff;
        font-size: 11px;
        font-weight: 700;
        padding: 4px 38px;
        transform: rotate(45deg);
        box-shadow: 0 2px 6px rgba(0,0,0,0.15);
        z-index: 2;
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function () {

        var searchInput = document.getElementById('searchInput');
        if (searchInput) {
            searchInput.addEventListener('input', function () {
                var term = this.value.toLowerCase();
                document.querySelectorAll('.plan-card-wrap').forEach(function (card) {
                    card.style.display = card.dataset.name.includes(term) ? '' : 'none';
                });
            });
        }

        document.querySelectorAll('.btn-delete-plan').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var id = this.dataset.id;
                var name = this.dataset.name;

                if (confirm('"' + name + '" planını silmek istediğinize emin misiniz?')) {
                    document.getElementById('deletePlanId').value = id;
                    document.getElementById('deleteForm').submit();
                }
            });
        });

    });
</script>