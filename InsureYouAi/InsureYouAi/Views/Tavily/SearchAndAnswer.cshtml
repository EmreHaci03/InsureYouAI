@{
    Layout = "/Views/Shared/_AdminLayout.cshtml";
    var query = ViewBag.Query as string;
    var answer = ViewBag.Answer as string;
}
@section BreadCrumb {
    <div class="page-breadcrumb d-none d-sm-flex align-items-center mb-3">
        <div class="breadcrumb-title pe-3"><i class="bi bi-search-heart me-1"></i>AI ile Ara ve Yanıtla</div>
        <div class="ps-3">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 p-0">
                    <li class="breadcrumb-item">
                        <a href="javascript:;"><i class="bx bx-home-alt"></i></a>
                    </li>
                    <li class="breadcrumb-item active" aria-current="page">Ara ve Yanıtla</li>
                </ol>
            </nav>
        </div>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-warning alert-dismissible fade show rounded-3 border-0 shadow-sm" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body p-4">
                <div class="d-flex align-items-center gap-2 mb-4">
                    <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                         style="width:38px; height:38px; background:rgba(99,102,241,0.1);">
                        <i class="bi bi-globe2" style="color:#6366f1;"></i>
                    </div>
                    <h6 class="fw-bold mb-0">Güncel Bilgiyle Soru Sor</h6>
                    <span class="badge rounded-pill bg-light text-dark ms-auto">
                        <i class="bi bi-search me-1" style="color:#6366f1;"></i>Tavily + AI
                    </span>
                </div>
                <p class="text-muted small mb-4">Sorunuzu yazın, önce web'den güncel bilgi taranır, ardından AI bu bilgiyle size özel bir yanıt oluşturur.</p>

                <form asp-action="SearchAndAnswer" method="post">
                    <div class="mb-3">
                        <div class="position-relative">
                            <i class="bi bi-question-circle position-absolute top-50 translate-middle-y ms-3 text-muted"></i>
                            <input type="text" name="userQuery" value="@query" required
                                   placeholder="Örn: 2026 trafik sigortası zorunlu teminatları nelerdir?"
                                   class="form-control ps-5 rounded-pill" style="padding-top:14px; padding-bottom:14px; font-size:14.5px;" />
                        </div>
                    </div>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 w-100">
                        <i class="bi bi-send-fill me-1"></i>Sor
                    </button>
                </form>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(answer))
        {
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center gap-2 mb-4">
                        <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                             style="width:38px; height:38px; background:rgba(139,92,246,0.1);">
                            <i class="bi bi-stars" style="color:#8b5cf6;"></i>
                        </div>
                        <h6 class="fw-bold mb-0">Yanıt</h6>
                        <span class="badge rounded-pill bg-light text-dark ms-auto">
                            <i class="bi bi-cpu me-1" style="color:#8b5cf6;"></i>AI Tarafından Oluşturuldu
                        </span>
                    </div>

                    <div class="bg-light rounded-3 p-3 mb-4" style="border-left:3px solid #6366f1;">
                        <span class="text-muted small">Sorunuz</span>
                        <p class="mb-0 fw-semibold" style="font-size:14.5px;">@query</p>
                    </div>

                    <div class="rounded-3 p-4" style="background:linear-gradient(135deg,#f9fafc,#f4f5f9); white-space:pre-wrap;">
                        <p class="mb-0 text-body" style="line-height:1.9; font-size:14.5px;">@answer</p>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
