@model GetMessageByIdDto
@{
    Layout = "/Views/Shared/_AdminLayout.cshtml";
    var initial = string.IsNullOrWhiteSpace(Model?.NameSurname) ? "?" : Model.NameSurname.Trim()[0].ToString().ToUpper();
}
@section BreadCrumb {
    <div class="page-breadcrumb d-none d-sm-flex align-items-center mb-3">
        <div class="breadcrumb-title pe-3"><i class="bi bi-envelope-open-fill me-1"></i>Mesaj Detayı</div>
        <div class="ps-3">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 p-0">
                    <li class="breadcrumb-item">
                        <a href="javascript:;"><i class="bx bx-home-alt"></i></a>
                    </li>
                    <li class="breadcrumb-item">
                        <a asp-action="MessageList">Mesajlar</a>
                    </li>
                    <li class="breadcrumb-item active" aria-current="page">Detay</li>
                </ol>
            </nav>
        </div>
    </div>
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-3 border-0 shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm position-relative overflow-hidden">
            <div style="height:90px; background:linear-gradient(135deg,#6366f1,#8b5cf6);"></div>

            <div class="card-body pt-0" style="margin-top:-45px;">
                <div class="d-flex align-items-end gap-3 mb-4 flex-wrap">
                    <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold text-white flex-shrink-0"
                         style="width:90px; height:90px; background:linear-gradient(135deg,#6366f1,#8b5cf6); font-size:32px; border:4px solid #fff; box-shadow:0 6px 18px rgba(0,0,0,0.12);">
                        @initial
                    </div>
                    <div class="pb-2">
                        <h5 class="fw-bold mb-1">@Model.NameSurname</h5>
                        <span class="text-muted small d-flex align-items-center gap-1">
                            <i class="bi bi-clock"></i>@Model.SendDate.ToString("dd MMMM yyyy, HH:mm")
                        </span>
                    </div>
                    <div class="ms-auto pb-2">
                        @if (Model.IsRead)
                        {
                            <span class="badge rounded-pill" style="background:#eafaf1; color:#28a745; font-size:12px; font-weight:700; padding:8px 16px;">
                                <i class="bi bi-envelope-open-fill me-1"></i>Okundu
                            </span>
                        }
                        else
                        {
                            <span class="badge rounded-pill" style="background:#fff8ec; color:#f59e0b; font-size:12px; font-weight:700; padding:8px 16px;">
                                <i class="bi bi-envelope-fill me-1"></i>Okunmadı
                            </span>
                        }
                    </div>
                </div>

                <hr>

                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <span class="text-muted small">E-posta</span>
                        <p class="fw-semibold mb-0 d-flex align-items-center gap-2">
                            <i class="bi bi-envelope" style="color:#6366f1;"></i>@Model.Email
                        </p>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.PhoneNumber))
                    {
                        <div class="col-md-6">
                            <span class="text-muted small">Telefon</span>
                            <p class="fw-semibold mb-0 d-flex align-items-center gap-2">
                                <i class="bi bi-telephone" style="color:#6366f1;"></i>@Model.PhoneNumber
                            </p>
                        </div>
                    }
                    <div class="col-12">
                        <span class="text-muted small">Konu</span>
                        <p class="fw-semibold mb-0 d-flex align-items-center gap-2">
                            <i class="bi bi-tag" style="color:#6366f1;"></i>@Model.Subject
                        </p>
                    </div>
                </div>

                <div class="bg-light rounded-3 p-4" style="border-left:3px solid #6366f1; white-space:pre-wrap;">
                    <p class="mb-0 text-body" style="line-height:1.9; font-size:14.5px;">@Model.MessageDetail</p>
                </div>

                <div class="d-flex gap-2 mt-4 flex-wrap">
                    <a asp-action="AutoReplyMessage" asp-route-id="@Model.MessageId" class="btn rounded-pill px-4 text-white" style="background:linear-gradient(135deg,#d97757,#c15f3c); border:none;">
                        <i class="bi bi-stars me-1"></i>Claude İle Yanıtla
                    </a>
                    <a asp-action="MessageList" class="btn btn-light rounded-pill px-4">
                        <i class="bi bi-arrow-left me-1"></i>Listeye Dön
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
