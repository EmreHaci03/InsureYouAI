@model List<GetCommentByIdDto>
@{
    Layout = "/Views/Shared/_AdminLayout.cshtml";
    var firstUser = Model.FirstOrDefault();
}
@section BreadCrumb {
    <div class="page-breadcrumb d-none d-sm-flex align-items-center mb-3">
        <div class="breadcrumb-title pe-3"><i class="bi bi-chat-square-text-fill me-1"></i>Kullanıcı Yorumları</div>
        <div class="ps-3">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 p-0">
                    <li class="breadcrumb-item">
                        <a href="javascript:;"><i class="bx bx-home-alt"></i></a>
                    </li>
                    <li class="breadcrumb-item">
                        <a asp-action="UserList">Kullanıcılar</a>
                    </li>
                    <li class="breadcrumb-item active" aria-current="page">Yorumları</li>
                </ol>
            </nav>
        </div>
    </div>
}

@if (firstUser != null)
{
    <div class="d-flex align-items-center gap-3 mb-4 p-3 rounded-3" style="background:linear-gradient(135deg,#6366f1,#8b5cf6);">
        <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold text-white flex-shrink-0"
             style="width:52px; height:52px; background:rgba(255,255,255,0.2); font-size:19px; border:2px solid rgba(255,255,255,0.4);">
            @(string.IsNullOrWhiteSpace(firstUser.AppUser) ? "?" : firstUser.AppUser.Trim()[0].ToString().ToUpper())
        </div>
        <div>
            <h5 class="fw-bold text-white mb-0">@firstUser.AppUser</h5>
            <p class="text-white small mb-0" style="opacity:.85;">Bu kullanıcının yaptığı tüm yorumlar</p>
        </div>
        <span class="badge rounded-pill bg-white text-dark ms-auto">@Model.Count yorum</span>
    </div>
}

@if (Model != null && Model.Any())
{
    <div class="d-flex flex-column gap-3">
        @foreach (var item in Model.OrderByDescending(x => x.CommentDate))
        {
            var preview = item.CommentDetail ?? "";

            <div class="card border-0 shadow-sm comment-row">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between mb-2 flex-wrap gap-2">
                        <span class="d-flex align-items-center gap-2 small fw-semibold" style="color:#6366f1;">
                            <i class="bi bi-file-earmark-text-fill"></i>
                            @item.Article
                        </span>
                        <span class="text-muted small d-flex align-items-center gap-1">
                            <i class="bi bi-clock"></i>@item.CommentDate.ToString("dd MMM yyyy, HH:mm")
                        </span>
                    </div>

                    <div class="bg-light rounded-3 p-3" style="border-left:3px solid #eceef4;">
                        <i class="bi bi-quote text-muted"></i>
                        <p class="mb-0 small text-body" style="line-height:1.6;">@preview</p>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="card border-0 shadow-sm">
        <div class="card-body text-center py-5">
            <div class="rounded-circle bg-light d-inline-flex align-items-center justify-content-center mb-3" style="width:72px; height:72px;">
                <i class="bi bi-chat-square-text fs-2 text-muted"></i>
            </div>
            <h6 class="fw-semibold">Bu kullanıcının hiç yorumu yok</h6>
            <p class="text-muted small mb-0">Kullanıcı bir makaleye yorum yaptığında burada listelenecek</p>
        </div>
    </div>
}

<style>
    .comment-row {
        transition: all 0.2s ease;
        border-radius: 14px;
    }

        .comment-row:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 22px rgba(0,0,0,0.08) !important;
        }
</style>
