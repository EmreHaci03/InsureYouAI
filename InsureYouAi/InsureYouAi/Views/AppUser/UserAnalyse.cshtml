@model GetAppUserByIdDto
@{
    Layout = "/Views/Shared/_AdminLayout.cshtml";
    var fullName = $"{Model?.Name} {Model?.SurName}".Trim();
    var safeName = string.IsNullOrWhiteSpace(fullName) ? "İsimsiz Kullanıcı" : fullName;
    var initial = string.IsNullOrWhiteSpace(Model?.Name) ? "?" : Model.Name.Trim()[0].ToString().ToUpper();
    var hasImage = !string.IsNullOrWhiteSpace(Model?.ImageUrl);
    var analysisText = ViewBag.AnalysisText as string;
}
@section BreadCrumb {
    <div class="page-breadcrumb d-none d-sm-flex align-items-center mb-3">
        <div class="breadcrumb-title pe-3"><i class="bi bi-stars me-1"></i>AI İçerik Analizi</div>
        <div class="ps-3">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 p-0">
                    <li class="breadcrumb-item">
                        <a href="javascript:;"><i class="bx bx-home-alt"></i></a>
                    </li>
                    <li class="breadcrumb-item">
                        <a asp-action="UserList">Kullanıcılar</a>
                    </li>
                    <li class="breadcrumb-item active" aria-current="page">AI Analizi</li>
                </ol>
            </nav>
        </div>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-warning alert-dismissible fade show rounded-3 border-0 shadow-sm" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Kullanıcı Başlık Şeridi -->
<div class="d-flex align-items-center gap-3 mb-4 p-3 rounded-3 position-relative overflow-hidden" style="background:linear-gradient(135deg,#8b5cf6,#6366f1);">
    <div class="position-absolute top-0 end-0 opacity-25" style="width:150px; height:150px; background:rgba(255,255,255,0.15); border-radius:50%; transform:translate(40%,-40%);"></div>

    @if (hasImage)
    {
        <img src="@Model.ImageUrl" alt="@safeName" class="rounded-circle flex-shrink-0 position-relative"
             style="width:56px; height:56px; object-fit:cover; border:3px solid rgba(255,255,255,0.4);" />
    }
    else
    {
        <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold text-white flex-shrink-0 position-relative"
             style="width:56px; height:56px; background:rgba(255,255,255,0.2); font-size:20px; border:2px solid rgba(255,255,255,0.4);">
            @initial
        </div>
    }
    <div class="position-relative">
        <h5 class="fw-bold text-white mb-0">@safeName</h5>
        <p class="text-white small mb-0" style="opacity:.85;">
            <i class="bi bi-stars me-1"></i>AI destekli içerik analizi
        </p>
    </div>
    <span class="badge rounded-pill bg-white text-dark ms-auto position-relative">
        <i class="bi bi-cpu me-1" style="color:#8b5cf6;"></i>GPT ile analiz edildi
    </span>
</div>

@if (!string.IsNullOrWhiteSpace(analysisText))
{
    <div class="card border-0 shadow-sm">
        <div class="card-body p-4 p-md-5">
            <div class="d-flex align-items-center gap-2 mb-4">
                <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                     style="width:38px; height:38px; background:rgba(139,92,246,0.1);">
                    <i class="bi bi-stars" style="color:#8b5cf6;"></i>
                </div>
                <h5 class="fw-bold mb-0">Analiz Raporu</h5>
            </div>

            <div class="analysis-content" style="line-height:1.9; color:#333;">
                @foreach (var line in analysisText.Split('\n', StringSplitOptions.RemoveEmptyEntries))
                {
                    var trimmed = line.Trim();
                    if (string.IsNullOrWhiteSpace(trimmed)) { continue; }

                    if (System.Text.RegularExpressions.Regex.IsMatch(trimmed, @"^\d+\.\s*\*{0,2}"))
                    {
                        <h6 class="fw-bold mt-4 mb-2" style="color:#6366f1;">
                            @System.Text.RegularExpressions.Regex.Replace(trimmed, @"\*", "")
                        </h6>
                    }
                    else if (trimmed.StartsWith("-") || trimmed.StartsWith("•"))
                    {
                        <div class="d-flex align-items-start gap-2 mb-2">
                            <i class="bi bi-caret-right-fill mt-1" style="color:#8b5cf6; font-size:11px;"></i>
                            <span class="small">@trimmed.TrimStart('-', '•', ' ')</span>
                        </div>
                    }
                    else
                    {
                        <p class="small mb-2">@trimmed</p>
                    }
                }
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-end mt-3">
        <a asp-action="UserAnalyse" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-secondary rounded-pill px-3">
            <i class="bi bi-arrow-clockwise me-1"></i>Analizi Yenile
        </a>
    </div>
}
else
{
    <div class="card border-0 shadow-sm">
        <div class="card-body text-center py-5">
            <div class="rounded-circle bg-light d-inline-flex align-items-center justify-content-center mb-3" style="width:72px; height:72px;">
                <i class="bi bi-stars fs-2 text-muted"></i>
            </div>
            <h6 class="fw-semibold">Henüz bir analiz oluşturulamadı</h6>
            <p class="text-muted small mb-0">Bu kullanıcının analiz edilecek yeterli içeriği bulunmuyor olabilir.</p>
        </div>
    </div>
}

<style>
    .analysis-content h6:first-child {
        margin-top: 0 !important;
    }
</style>
