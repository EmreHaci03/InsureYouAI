@model List<ResultArticleDto>
@{
    Layout = "/Views/Shared/_AdminLayout.cshtml";
    string[] gradients = new[]
    {
        "linear-gradient(135deg,#6366f1,#8b5cf6)",
        "linear-gradient(135deg,#06b6d4,#3b82f6)",
        "linear-gradient(135deg,#f59e0b,#ef4444)",
        "linear-gradient(135deg,#10b981,#059669)",
        "linear-gradient(135deg,#ec4899,#f43f5e)",
    };
}
@section BreadCrumb {
    <div class="page-breadcrumb d-none d-sm-flex align-items-center mb-3">
        <div class="breadcrumb-title pe-3"><i class="bi bi-newspaper me-1"></i>Makaleler</div>
        <div class="ps-3">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 p-0">
                    <li class="breadcrumb-item">
                        <a href="javascript:;"><i class="bx bx-home-alt"></i></a>
                    </li>
                    <li class="breadcrumb-item">
                        <a asp-action="ArticleList">Makaleler</a>
                    </li>
                    <li class="breadcrumb-item active" aria-current="page">Liste</li>
                </ol>
            </nav>
        </div>
    </div>
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-3 border-0 shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="d-flex flex-wrap align-items-center justify-content-between mb-4 gap-3">
    <div>
        <h4 class="fw-bold mb-1">Makaleler <span class="badge rounded-pill bg-light text-dark ms-1">@(Model?.Count ?? 0)</span></h4>
        <p class="text-muted mb-0 small">Blog ve bilgi içeriklerinizi yönetin</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <div class="position-relative">
            <i class="bi bi-search position-absolute top-50 translate-middle-y ms-3 text-muted"></i>
            <input class="form-control ps-5 rounded-pill border-0 shadow-sm" type="text" placeholder="Makale ara..." id="searchInput" style="min-width:240px;">
        </div>
        <a asp-action="CreateArticleWithOpenAi" class="btn rounded-pill px-4 shadow-sm text-white" style="background:linear-gradient(135deg,#8b5cf6,#6366f1); border:none;">
            <i class="bi bi-stars me-1"></i>Ai İle Oluştur
        </a>
        <a asp-action="CreateArticle" class="btn btn-primary rounded-pill px-4 shadow-sm">
            <i class="bi bi-plus-lg me-1"></i>Yeni Makale
        </a>
    </div>
</div>

@if (Model != null && Model.Any())
{
    <div class="row g-3" id="articleGrid">
        @for (int i = 0; i < Model.Count; i++)
        {
            var item = Model[i];
            var gradient = gradients[i % gradients.Length];
            var safeTitle = item.Title ?? "";
            var safeCategory = item.Category ?? "Kategorisiz";

            <div class="col-xl-4 col-lg-6 article-card-wrap" data-name="@((safeTitle + " " + safeCategory).ToLower())">
                <div class="card border-0 shadow-sm h-100 article-card overflow-hidden">
                    <div class="position-relative">
                        @if (!string.IsNullOrEmpty(item.CoverImageUrl))
                        {
                            <img src="@item.CoverImageUrl" class="w-100" style="height:170px; object-fit:cover;" alt="@safeTitle" />
                        }
                        else
                        {
                            <div class="w-100 d-flex align-items-center justify-content-center" style="height:170px; background:@gradient;">
                                <i class="bi bi-newspaper text-white fs-1 opacity-75"></i>
                            </div>
                        }
                        <div class="dropdown position-absolute top-0 end-0 mt-2 me-2">
                            <button class="btn btn-sm btn-icon border-0 bg-white shadow-sm rounded-circle" type="button" data-bs-toggle="dropdown">
                                <i class="bi bi-three-dots-vertical"></i>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0">
                                <li>
                                    <a class="dropdown-item" asp-action="ArticleDetail" asp-route-id="@item.ArticleId">
                                        <i class="bi bi-eye-fill me-2 text-info"></i>Görüntüle
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-action="UpdateArticle" asp-route-id="@item.ArticleId">
                                        <i class="bi bi-pencil-fill me-2 text-warning"></i>Düzenle
                                    </a>
                                </li>
                                <li>
                                    <button type="button" class="dropdown-item text-danger btn-delete-article"
                                            data-id="@item.ArticleId" data-name="@safeTitle" data-category="@safeCategory" data-image="@item.CoverImageUrl" data-gradient="@gradient">
                                        <i class="bi bi-trash-fill me-2"></i>Sil
                                    </button>
                                </li>
                            </ul>
                        </div>
                        <span class="badge rounded-pill position-absolute bottom-0 start-0 mb-2 ms-2" style="background:@gradient; color:#fff;">
                            @safeCategory
                        </span>
                    </div>

                    <div class="card-body">
                        <h6 class="fw-semibold mb-2">
                            <a asp-action="ArticleDetail" asp-route-id="@item.ArticleId" class="text-decoration-none text-dark stretched-link-title">@item.Title</a>
                        </h6>
                        <p class="text-muted small mb-2">
                            @{
                                var plainContent = System.Text.RegularExpressions.Regex.Replace(item.Content ?? "", "<.*?>", "");
                            }
                            @(plainContent.Length > 90 ? plainContent.Substring(0, 90) + "..." : plainContent)
                        </p>
                        <div class="d-flex align-items-center justify-content-between">
                            <div class="d-flex align-items-center gap-2 text-muted small">
                                <i class="bi bi-calendar3"></i>@item.CreatedDate.ToString("dd MMMM yyyy")
                            </div>
                            <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-3 btn-delete-article"
                                    data-id="@item.ArticleId" data-name="@safeTitle" data-category="@safeCategory" data-image="@item.CoverImageUrl" data-gradient="@gradient">
                                <i class="bi bi-trash-fill"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="card border-0 shadow-sm">
        <div class="card-body text-center py-5">
            <div class="rounded-circle bg-light d-inline-flex align-items-center justify-content-center mb-3" style="width:72px; height:72px;">
                <i class="bi bi-inbox fs-2 text-muted"></i>
            </div>
            <h6 class="fw-semibold">Henüz makale eklenmemiş</h6>
            <p class="text-muted small">Başlamak için ilk makalenizi oluşturun</p>
            <a asp-action="CreateArticle" class="btn btn-primary rounded-pill px-4 mt-2">
                <i class="bi bi-plus-lg me-1"></i>İlk Makaleyi Ekle
            </a>
        </div>
    </div>
}

<form id="deleteForm" asp-action="DeleteArticle" method="post" class="d-none">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" id="deleteArticleId" value="" />
</form>

<!-- Silme Onay Modalı -->
<div class="modal fade" id="deleteConfirmModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius:20px; overflow:hidden;">
            <div class="modal-body p-0">
                <div class="text-center pt-4 pb-2 px-4">
                    <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-3"
                         style="width:72px; height:72px; background:#fdeaea;">
                        <i class="bi bi-trash3-fill text-danger" style="font-size:28px;"></i>
                    </div>
                    <h5 class="fw-bold mb-1">Makaleyi Sil</h5>
                    <p class="text-muted small mb-3">Bu işlem geri alınamaz. Devam etmek istediğinize emin misiniz?</p>
                </div>

                <div class="mx-4 mb-4 rounded-3 bg-light overflow-hidden d-flex align-items-center gap-3" style="border-left:3px solid #dc3545;">
                    <div id="deleteArtThumbWrap" style="width:64px; height:64px; flex-shrink:0; overflow:hidden;">
                        <img id="deleteArtThumb" src="" style="width:100%; height:100%; object-fit:cover; display:none;" />
                        <div id="deleteArtThumbFallback" class="w-100 h-100 d-flex align-items-center justify-content-center">
                            <i class="bi bi-newspaper text-white fs-4 opacity-75"></i>
                        </div>
                    </div>
                    <div class="min-w-0 text-start py-2 pe-3">
                        <h6 id="deleteArtName" class="fw-semibold mb-1 small text-truncate"></h6>
                        <span id="deleteArtCategory" class="badge rounded-pill" style="font-size:11px;"></span>
                    </div>
                </div>

                <div class="d-flex gap-2 px-4 pb-4">
                    <button type="button" class="btn btn-light flex-grow-1 rounded-pill fw-semibold" data-bs-dismiss="modal">
                        Vazgeç
                    </button>
                    <button type="button" id="confirmDeleteArtBtn" class="btn btn-danger flex-grow-1 rounded-pill fw-semibold shadow-sm">
                        <i class="bi bi-trash3-fill me-1"></i>Evet, Sil
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .article-card {
        transition: all 0.25s ease;
        border-radius: 16px;
    }

        .article-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 24px rgba(0,0,0,0.08) !important;
        }

    .min-w-0 {
        min-width: 0;
    }

    #deleteConfirmModal .modal-content {
        animation: modalPopArt .25s ease;
    }

    @@keyframes modalPopArt {
        from {
            opacity: 0;
            transform: scale(.92);
        }

        to {
            opacity: 1;
            transform: scale(1);
        }
    }

    #confirmDeleteArtBtn:hover {
        background: #b02a37;
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function () {

        var searchInput = document.getElementById('searchInput');
        if (searchInput) {
            searchInput.addEventListener('input', function () {
                var term = this.value.toLowerCase();
                document.querySelectorAll('.article-card-wrap').forEach(function (card) {
                    card.style.display = card.dataset.name.includes(term) ? '' : 'none';
                });
            });
        }

        var deleteModalEl = document.getElementById('deleteConfirmModal');
        var deleteModal = new bootstrap.Modal(deleteModalEl);
        var pendingDeleteId = null;

        document.querySelectorAll('.btn-delete-article').forEach(function (btn) {
            btn.addEventListener('click', function () {
                pendingDeleteId = this.dataset.id;

                document.getElementById('deleteArtName').textContent = this.dataset.name;

                var catEl = document.getElementById('deleteArtCategory');
                catEl.textContent = this.dataset.category;
                catEl.style.background = this.dataset.gradient;
                catEl.style.color = '#fff';

                var img = document.getElementById('deleteArtThumb');
                var fallback = document.getElementById('deleteArtThumbFallback');
                var imageUrl = this.dataset.image;

                if (imageUrl) {
                    img.src = imageUrl;
                    img.style.display = 'block';
                    fallback.style.display = 'none';
                } else {
                    img.style.display = 'none';
                    fallback.style.display = 'flex';
                    fallback.style.background = this.dataset.gradient;
                }

                deleteModal.show();
            });
        });

        document.getElementById('confirmDeleteArtBtn').addEventListener('click', function () {
            if (!pendingDeleteId) return;

            var btn = this;
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Siliniyor...';

            document.getElementById('deleteArticleId').value = pendingDeleteId;
            document.getElementById('deleteForm').submit();
        });

    });
</script>
