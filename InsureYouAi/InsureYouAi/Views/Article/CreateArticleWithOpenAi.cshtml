@{
    Layout = "/Views/Shared/_AdminLayout.cshtml";
    var categories = ViewBag.Categories as List<ResultCategoryDto>;
    string generatedContent = ViewBag.Content as string;
}
@section BreadCrumb {
    <div class="page-breadcrumb d-none d-sm-flex align-items-center mb-3">
        <div class="breadcrumb-title pe-3"><i class="bi bi-stars me-1"></i>Ai İle Makale Oluştur</div>
        <div class="ps-3">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 p-0">
                    <li class="breadcrumb-item">
                        <a href="javascript:;"><i class="bx bx-home-alt"></i></a>
                    </li>
                    <li class="breadcrumb-item">
                        <a asp-action="ArticleList">Makaleler</a>
                    </li>
                    <li class="breadcrumb-item active" aria-current="page">Ai İle Oluştur</li>
                </ol>
            </nav>
        </div>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show rounded-3 border-0 shadow-sm" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row justify-content-center">
    <div class="col-xl-8 col-lg-10">

        <!-- Prompt giriş kartı -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body p-4">
                <div class="d-flex align-items-center gap-3 mb-4">
                    <div class="rounded-4 d-flex align-items-center justify-content-center flex-shrink-0"
                         style="width:52px; height:52px; background:linear-gradient(135deg,#8b5cf6,#6366f1);">
                        <i class="bi bi-stars text-white fs-5"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold mb-0">Ai İle Makale Oluştur</h5>
                        <p class="text-muted small mb-0">Konuyu yazın, yapay zeka sizin için makale üretsin</p>
                    </div>
                </div>

                <form asp-action="CreateArticleWithOpenAi" method="post">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Konu / Prompt</label>
                        <textarea name="prompt" class="form-control rounded-3" rows="3"
                                  placeholder="Örn: Kasko sigortası neden önemlidir, hangi durumları kapsar?" required></textarea>
                    </div>
                    <div class="d-flex justify-content-end">
                        <button type="submit" class="btn rounded-pill px-4 shadow-sm text-white" style="background:linear-gradient(135deg,#8b5cf6,#6366f1); border:none;">
                            <i class="bi bi-stars me-1"></i>Oluştur
                        </button>
                    </div>
                </form>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(generatedContent))
        {
            <!-- Üretilen içerik + kaydetme formu -->
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center gap-2 mb-4">
                        <i class="bi bi-check-circle-fill text-success fs-5"></i>
                        <h6 class="fw-bold mb-0">İçerik Üretildi — Kontrol Edip Kaydedin</h6>
                    </div>

                    <form asp-action="CreateArticle" asp-controller="Article" method="post">
                        <div class="mb-4">
                            <label class="form-label fw-semibold">Başlık</label>
                            <input name="Title" class="form-control rounded-3" placeholder="Makale başlığı girin" required />
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-semibold">Kategori</label>
                            <select name="CategoryId" class="form-select rounded-3">
                                <option value="">-- Seçiniz --</option>
                                @if (categories != null)
                                {
                                    @foreach (var category in categories)
                                    {
                                        <option value="@category.CategoryId">@category.CategoryName</option>
                                    }
                                }
                            </select>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-semibold">İçerik</label>
                            <textarea name="Content" class="form-control rounded-3" rows="12">@generatedContent</textarea>
                            <small class="text-muted">İçeriği kaydetmeden önce dilediğiniz gibi düzenleyebilirsiniz.</small>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-semibold">Kapak Görseli URL</label>
                            <input name="CoverImageUrl" class="form-control rounded-3" placeholder="https://..." />
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-semibold">Ana Kapak Görseli URL</label>
                            <input name="MainCoverImageUrl" class="form-control rounded-3" placeholder="https://..." />
                        </div>

                        <div class="d-flex justify-content-end gap-2">
                            <a asp-action="ArticleList" class="btn btn-light rounded-pill px-4">Vazgeç</a>
                            <button type="submit" class="btn btn-primary rounded-pill px-4 shadow-sm">
                                <i class="bi bi-check-lg me-1"></i>Makaleyi Kaydet
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        }

    </div>
</div>